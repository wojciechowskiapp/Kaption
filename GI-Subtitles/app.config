<?xml version="1.0" encoding="utf-8"?>
<!--
  Net8 migration (2026-04-23): this file is now the log4net sidecar only.
  GC settings moved to runtimeconfig.template.json. Binding redirects
  deleted (inert on .NET 8 — Core+ assembly loader ignores them). <startup>
  supportedRuntime deleted. <uri> schemeSettings deleted (default Uri
  behavior on net8 matches what we need for R2 URLs).
-->
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <log4net>
    <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%envFolderPath{ApplicationData}\Kaption\app.log" />
      <appendToFile value="true" />
      <datePattern value="yyyyMMdd-HH:mm:ss" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="1" />
      <maximumFileSize value="10MB" />
      <encoding value="utf-8" />
      <!--
        immediateFlush=true disables the buffer and forces every log line to disk
        before the call returns. Slight perf cost (~microseconds per line) in
        exchange for: when the process dies from a native crash / stack overflow /
        AccessViolation that our managed exception handlers can't observe, the
        last few log lines before the crash are still on disk for diagnosis.
      -->
      <immediateFlush value="true" />
      <!--
        The root level is DEBUG (see below) so that debug records reach the
        in-memory buffer, but the DISK file stays INFO-and-above. log4net
        evaluates the logger level first and the appender threshold second,
        so this threshold is what keeps app.log the same size and shape it
        has always been. Raise it to DEBUG only via Config.LogLevel, which
        Logger.ApplyConfiguredLevel applies to this appender too.
      -->
      <threshold value="INFO" />
      <layout type="log4net.Layout.PatternLayout">
        <footer value="" />
        <conversionPattern value="[%-5level] Time：%date Content：%message%newline" />
      </layout>
    </appender>
    <root>
      <!--
        DEBUG here does NOT mean debug output on disk — the LogFileAppender
        threshold above holds the file at INFO. The point is that debug
        records are generated and kept in the in-memory ring (LogBuffer),
        so a user hitting a bug can produce a diagnostic bundle with
        debug-level history of the minutes leading up to it, without
        having enabled anything beforehand or restarting.

        Per-frame OCR spam (tick timings, pixel-change ratios) is separately
        gated behind the `Debug` bool in Config.json and stays off; without
        that gate it would evict the ring buffer within minutes.

        Users who want debug output on DISK can still set `LogLevel=DEBUG`
        in %APPDATA%\Kaption\Config.json, or use the Diagnostics section in
        Settings. Logger.ApplyConfiguredLevel reads it at startup and also
        drops the file appender's threshold to match.
      -->
      <level value="DEBUG" />
      <appender-ref ref="LogFileAppender" />
    </root>
  </log4net>
</configuration>
