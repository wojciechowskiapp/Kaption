<?xml version="1.0" encoding="utf-8"?>
<!--
  Net8 migration (2026-04-23): this file is now the log4net sidecar only.
  GC settings moved to runtimeconfig.template.json. Binding redirects
  deleted (inert on .NET 8 — Core+ assembly loader ignores them). <startup>
  supportedRuntime deleted. <uri> schemeSettings deleted (default Uri
  behavior on net8 matches what we need for R2 URLs).
-->
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <log4net>
    <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%envFolderPath{ApplicationData}\Kaption\app.log" />
      <appendToFile value="true" />
      <datePattern value="yyyyMMdd-HH:mm:ss" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="1" />
      <maximumFileSize value="10MB" />
      <encoding value="utf-8" />
      <!--
        immediateFlush=true disables the buffer and forces every log line to disk
        before the call returns. Slight perf cost (~microseconds per line) in
        exchange for: when the process dies from a native crash / stack overflow /
        AccessViolation that our managed exception handlers can't observe, the
        last few log lines before the crash are still on disk for diagnosis.
      -->
      <immediateFlush value="true" />
      <!--
        Belt and braces. The root level is INFO, so debug records are not
        produced at all in a shipping build and this threshold has nothing
        to filter. It still matters in two cases: Debug builds, where
        App.OnStartup raises the root level, and any future appender-level
        experiment. Logger.ApplyConfiguredLevel moves this threshold and the
        root level together when the user sets Config.LogLevel, so asking
        for DEBUG really does put debug on disk.
      -->
      <threshold value="INFO" />
      <layout type="log4net.Layout.PatternLayout">
        <footer value="" />
        <conversionPattern value="[%-5level] Time：%date Content：%message%newline" />
      </layout>
    </appender>
    <root>
      <!--
        INFO, not DEBUG. In log4net the LOGGER LEVEL is the real switch: at
        DEBUG every Logger.Log.Debug(...) call builds a LoggingEvent and
        fans it out to every appender, each of which then decides. At INFO
        log4net returns straight after the level check, so nothing is
        allocated and nothing is dispatched.

        This used to be DEBUG so the in-memory ring (LogBuffer) carried
        debug history into diagnostic bundles without the user enabling
        anything. That cost every install a LoggingEvent plus three appender
        dispatches per debug call, in a real-time capture loop, to produce
        records that never reached disk. Bundles now carry INFO and above.

        NOTE: the level check does NOT save the cost of building the
        message. $"..." is evaluated by the CALLER before log4net is
        entered. Only an IsDebugEnabled guard avoids that — see
        Logger.IsDebugEnabled and the rule in CLAUDE.md.

        Users who need debug on disk set LogLevel=DEBUG in Config.json or
        use Diagnostics in Settings; Logger.ApplyConfiguredLevel raises the
        root level and the file appender threshold together. Debug builds
        still default to DEBUG via the #if DEBUG block in App.OnStartup.
      -->
      <level value="INFO" />
      <appender-ref ref="LogFileAppender" />
    </root>
  </log4net>
</configuration>
