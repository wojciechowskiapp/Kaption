<Window x:Class="GI_Subtitles.Views.SendFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell"
        Title="{DynamicResource Feedback_WindowTitle}"
        Height="560" Width="540"
        Icon="../Resources/kaption.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{DynamicResource KaptionWindow}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shell:TitleBar Title="{DynamicResource Feedback_WindowTitle}" CanMinimize="False" CanMaximize="False"/>

        <Grid Grid.Row="1" Margin="28,22,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Feedback_Heading}" Style="{StaticResource PageHeading}"/>
            <TextBlock Grid.Row="1" Text="{DynamicResource Feedback_Explainer}" Style="{StaticResource BodyText}" Margin="0,6,0,14"/>

            <!-- One click to say what kind of note this is; prepended as "[Bug] …" for the backend. -->
            <WrapPanel x:Name="CategoryPanel" Grid.Row="2" Margin="0,0,0,12">
                <Button x:Name="CatBug" Tag="Bug" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Feedback_Cat_Bug}"
                        Padding="14,0" Margin="0,0,8,8" Click="CategoryChip_Click"/>
                <Button x:Name="CatIdea" Tag="Idea" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Feedback_Cat_Idea}"
                        Padding="14,0" Margin="0,0,8,8" Click="CategoryChip_Click"/>
                <Button x:Name="CatLove" Tag="Love" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Feedback_Cat_Love}"
                        Padding="14,0" Margin="0,0,8,8" Click="CategoryChip_Click"/>
                <Button x:Name="CatOther" Tag="Other" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Feedback_Cat_Other}"
                        Padding="14,0" Margin="0,0,0,8" Click="CategoryChip_Click"/>
            </WrapPanel>

            <Grid x:Name="ComposePanel" Grid.Row="3">
                <TextBox x:Name="MessageBox" Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                         MaxLength="2000" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="12,10"
                         AutomationProperties.Name="{DynamicResource Feedback_Heading}"
                         TextChanged="MessageBox_TextChanged"/>
            </Grid>

            <!-- Counter turns amber at 80 % and red at 100 % (code-behind). -->
            <Grid Grid.Row="4" Margin="2,8,2,0">
                <TextBlock x:Name="ErrorText" HorizontalAlignment="Left" Style="{StaticResource HintText}"
                           Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock x:Name="CharCount" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" Text="0 / 2000"/>
            </Grid>

            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Feedback_PrivacyNote}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <Button x:Name="BtnCancel" Grid.Column="1" Style="{StaticResource GhostButton}" Content="{DynamicResource Common_Cancel}"
                        Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="BtnSend" Grid.Column="2" Style="{StaticResource ModernButton}" Content="{DynamicResource Feedback_Send}"
                        MinWidth="110" Margin="0" IsEnabled="False" Click="Send_Click" IsDefault="True"/>
            </Grid>

            <!-- Thank-you state, in the compose area's place. -->
            <StackPanel x:Name="ThanksPanel" Grid.Row="3" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SuccessLightBrush}" HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <Path Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="None" StrokeThickness="2"
                          Stroke="{DynamicResource SuccessBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                        </Path.RenderTransform>
                    </Path>
                </Border>
                <TextBlock Text="{DynamicResource Feedback_ThanksTitle}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"
                           Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{DynamicResource Feedback_ThanksBody}" Style="{StaticResource BodyText}" TextAlignment="Center" MaxWidth="360"/>
                <Button x:Name="BtnClose" Style="{StaticResource ModernButton}" Content="{DynamicResource Common_Close}"
                        HorizontalAlignment="Center" MinWidth="120" Margin="0,18,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
