<Window x:Class="GI_Subtitles.Views.HintStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaption hints"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/CharacterPaletteDark.xaml"/>
                <!-- The Ctrl+Q popup's tooltip and buttons. -->
                <ResourceDictionary Source="../Themes/OverlayChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The card's buttons: the only part of the hint card that takes a click, so it is up only on purpose. -->
    <Border x:Name="RootBorder" Background="{DynamicResource Char_Overlay}" CornerRadius="9" Padding="3,2"
            BorderBrush="{DynamicResource Char_OverlayRing}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="NeverButton" Style="{StaticResource QtTextButton}" Padding="8,0" Focusable="False" Visibility="Collapsed"
                    Content="{DynamicResource Hint_Strip_Never}" Click="NeverButton_Click"/>
            <ToggleButton x:Name="PinButton" Style="{StaticResource QtIconToggle}" Content="&#xE718;" Click="PinButton_Click"/>
            <!-- Drawn, not a font glyph: the icon font on Windows 10 has no "move" arrows. -->
            <Button x:Name="MoveButton" Style="{StaticResource QtIconButton}"
                    ToolTip="{DynamicResource Hint_Strip_Move}" Click="MoveButton_Click">
                <Path Data="M8,2 V14 M2,8 H14 M8,2 L6,4 M8,2 L10,4 M8,14 L6,12 M8,14 L10,12 M2,8 L4,6 M2,8 L4,10 M14,8 L12,6 M14,8 L12,10"
                      Width="16" Height="16" Stretch="None" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource QtIconButton}" Content="&#xE8BB;" FontSize="10"
                    ToolTip="{DynamicResource Hint_Strip_Hide}" Click="CloseButton_Click"/>
        </StackPanel>
    </Border>
</Window>
