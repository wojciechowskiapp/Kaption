<Window x:Class="GI_Subtitles.Views.HintCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaption hints"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <!-- The Ctrl+Q popup's palette, so the two read as one family; Char_Accent is set per game in code. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/CharacterPaletteDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A shortcut as the player has it ("Ctrl+Shift+H"). -->
            <Style x:Key="HintKeycap" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Char_ChipBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Char_OverlayRing}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="7,2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <Style x:Key="HintKeycapText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Char_Accent}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The panel. Its opacity carries the fades and the pinned sheet's rest; the window itself never changes. -->
    <Border x:Name="RootBorder" Background="{DynamicResource Char_Overlay}" CornerRadius="12"
            BorderBrush="{DynamicResource Char_OverlayRing}" BorderThickness="1" MinWidth="220" MaxWidth="420">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kaption's band (kaption.one .k-band): the game's accent on the left edge. -->
            <Border Margin="12,11,14,11" Padding="11,0,0,0" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Char_Accent}">
                <StackPanel>
                    <StackPanel x:Name="HeaderRow" Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="{DynamicResource KaptionMarkOnFill}" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HeaderText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Char_FgSubtle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- The keycaps share one column, so the labels line up. -->
                    <ItemsControl x:Name="RowList" Focusable="False" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row" Height="26" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="HintKeys"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HintKeycap}" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource HintKeycapText}" Text="{Binding Keys}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" Foreground="{DynamicResource Char_Fg}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Row" Property="Margin" Value="0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="{DynamicResource Char_FgMuted}" Margin="0,10,0,0"
                               TextWrapping="Wrap"/>

                    <!-- An echo or a tip: one or two lines, the shortcut as a keycap in the sentence. -->
                    <TextBlock x:Name="MessageText" FontSize="13.5" Foreground="{DynamicResource Char_Fg}" TextWrapping="Wrap"
                               MaxWidth="352" LineHeight="24" LineStackingStrategy="BlockLineHeight" Margin="0,-1,0,-1"/>
                </StackPanel>
            </Border>

            <!-- The clock: how long the card stays. None on an echo or a pinned sheet. -->
            <Border x:Name="ClockTrack" Grid.Row="1" Height="2" Margin="12,-4,12,6" CornerRadius="1">
                <Border x:Name="ClockBar" HorizontalAlignment="Left" CornerRadius="1"
                        Background="{DynamicResource Char_Accent}" Opacity="0.8"/>
            </Border>
        </Grid>
    </Border>
</Window>
