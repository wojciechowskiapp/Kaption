<Window x:Class="GI_Subtitles.Views.SuggestFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell"
        Title="{DynamicResource fix_Window_Title}"
        Width="560" SizeToContent="Height"
        Icon="../Resources/kaption.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Style="{DynamicResource KaptionWindow}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <shell:TitleBar Title="{DynamicResource fix_Window_Title}" CanMinimize="False" CanMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="24,14,24,20">
            <!-- The line as the overlay showed it: speaker, English, the Polish in use now. -->
            <Border Style="{StaticResource Callout}" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="SpeakerText" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource AccentTextBrush}"
                               Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource fix_English_Label}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="EnglishText" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextBrush}"
                               MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource fix_Current_Label}" Margin="0,12,0,2"/>
                    <TextBlock x:Name="CurrentText" Style="{StaticResource BodyText}" MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource fix_Yours_Label}" Margin="0,16,0,6"/>
            <TextBox x:Name="FixBox" Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="80" MaxHeight="200" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8"
                     AutomationProperties.Name="{DynamicResource fix_Yours_Label}" TextChanged="FixBox_TextChanged"/>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource fix_Note_Label}" Margin="0,12,0,6"/>
            <TextBox x:Name="NoteBox" Style="{StaticResource ModernTextBox}" TextWrapping="Wrap"
                     AutomationProperties.Name="{DynamicResource fix_Note_Label}"/>

            <!-- Set in code: whether the fix also goes to review depends on the game, the language and the line. -->
            <TextBlock x:Name="SendHint" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
            <TextBlock x:Name="ErrorText" Style="{StaticResource HintText}" Foreground="{DynamicResource ErrorBrush}"
                       Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnCancel" Style="{StaticResource GhostButton}" Content="{DynamicResource Common_Cancel}"
                        Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="BtnSave" Style="{StaticResource ModernButton}" Content="{DynamicResource fix_Save}"
                        MinWidth="110" Margin="0" IsEnabled="False" Click="Save_Click"
                        ToolTip="{DynamicResource fix_Save_Tip}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
