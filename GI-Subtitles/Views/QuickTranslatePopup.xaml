<Window x:Class="GI_Subtitles.Views.QuickTranslatePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MinWidth="280" Opacity="0"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
        <!-- Dark palette; CharacterOverviewView reads the Char_* keys from its host. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/CharacterPaletteDark.xaml"/>
            <ResourceDictionary Source="../Themes/ScrollBars.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF"/>

        <!-- Over the game: ink at 94% with a hairline ring (kaption.one surfaces). -->
        <SolidColorBrush x:Key="Qt_Surface" Color="#F00B0D17"/>
        <SolidColorBrush x:Key="Qt_Ring" Color="#26FFFFFF"/>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Background" Value="#181C2A"/>
            <Setter Property="BorderBrush" Value="#232838"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QtIconButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="#C9CED8"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QtIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource QtIconButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Char_Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QtTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <ContentPresenter Margin="0,5,0,4"/>
                            <Border x:Name="Underline" Height="2" CornerRadius="1" Background="Transparent"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Char_Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource Qt_Surface}" CornerRadius="12"
            BorderBrush="{StaticResource Qt_Ring}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: drag handle, tabs, actions. -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent" Margin="12,6,6,2"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <RadioButton x:Name="TranslationTab" GroupName="QtTabs" IsChecked="True" Style="{StaticResource QtTab}"
                                 Content="{DynamicResource QuickTranslate_Tab_Translation}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="OverviewTab" GroupName="QtTabs" Style="{StaticResource QtTab}" Checked="Tab_Checked"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="OriginalToggle" Style="{StaticResource QtIconToggle}" Width="32"
                                  FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Content="EN"
                                  ToolTip="{DynamicResource QuickTranslate_Tip_ShowOriginal}" Click="OriginalToggle_Click"/>
                    <Button x:Name="CopyButton" Style="{StaticResource QtIconButton}" Content="&#xE8C8;"
                            ToolTip="{DynamicResource QuickTranslate_Tip_Copy}" Click="CopyButton_Click"/>
                    <ToggleButton x:Name="PinButton" Style="{StaticResource QtIconToggle}" Content="&#xE718;"
                                  ToolTip="{DynamicResource QuickTranslate_Tip_Pin}" Click="PinButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource QtIconButton}" Content="&#xE8BB;" FontSize="10"
                            ToolTip="{DynamicResource QuickTranslate_Tip_Close}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <!-- Kaption's subtitle band (kaption.one .k-band): the game's accent on the left edge.
                     Transparent background so a click between paragraphs still counts as "close". -->
                <Border x:Name="TranslationBand" Margin="14,4,14,12" Padding="12,2,2,0" BorderThickness="3,0,0,0"
                        BorderBrush="{DynamicResource Char_Accent}">
                    <StackPanel x:Name="TranslationPanel" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonUp="TranslationPanel_MouseLeftButtonUp"/>
                </Border>
            </ScrollViewer>
            <!-- The character page scrolls itself, edge to edge, so its section tabs can stay pinned. -->
            <ContentControl x:Name="OverviewHost" Grid.Row="1" Margin="0,2,0,0" Visibility="Collapsed" Focusable="False"/>

            <Border x:Name="CountdownTrack" Grid.Row="2" Height="3" Margin="12,0,12,7" CornerRadius="1.5"
                    Background="#1FFFFFFF">
                <Border x:Name="CountdownBar" HorizontalAlignment="Left" CornerRadius="1.5"
                        Background="{DynamicResource Char_Accent}" Opacity="0.8"/>
            </Border>
        </Grid>
    </Border>
</Window>
