<Window x:Class="GI_Subtitles.Views.QuickTranslatePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GI_Subtitles.Views"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MinWidth="280" Opacity="0"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
        <!-- Dark palette; CharacterOverviewView reads the Char_* keys from its host. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/CharacterPaletteDark.xaml"/>
            <ResourceDictionary Source="../Resources/CharacterLayoutPopup.xaml"/>
            <ResourceDictionary Source="../Themes/ScrollBars.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- Every colour comes from the palette's semantic keys (CharacterPaletteDark.xaml). -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Char_Fg}"/>
            <Setter Property="Background" Value="{DynamicResource Char_TooltipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Char_TooltipRing}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QtIconButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource Char_FgMuted}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Char_Fg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QtIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource QtIconButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Char_Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A text button in the header ("Wróć do tłumaczenia"). -->
        <Style x:Key="QtTextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Char_FgMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Char_Fg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:IconImageConverter x:Key="QtIconImage"/>
        <local:MissingIconConverter x:Key="QtMissingIcon"/>
        <BooleanToVisibilityConverter x:Key="QtBoolVis"/>

        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource Char_Overlay}" CornerRadius="12"
            BorderBrush="{DynamicResource Char_OverlayRing}" BorderThickness="1">
        <!-- One view, no tabs: the translation, and under it a strip when Kaption recognised the character on screen.
             "Otwórz kartę" opens the character's page inline; the strip then heads the page (row 1, not row 3). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: drag handle, the way back from the page, actions. -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent" Margin="12,6,6,2"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource QtTextButton}" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9.5,4 L5.5,8 L9.5,12" Width="16" Height="16" Stretch="None" StrokeThickness="1.6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0"/>
                        <TextBlock Text="{DynamicResource QuickTranslate_Back}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="OriginalToggle" Style="{StaticResource QtIconToggle}" Width="32"
                                  FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Content="EN"
                                  ToolTip="{DynamicResource QuickTranslate_Tip_ShowOriginal}" Click="OriginalToggle_Click"/>
                    <Button x:Name="CopyButton" Style="{StaticResource QtIconButton}" Content="&#xE8C8;"
                            ToolTip="{DynamicResource QuickTranslate_Tip_Copy}" Click="CopyButton_Click"/>
                    <ToggleButton x:Name="PinButton" Style="{StaticResource QtIconToggle}" Content="&#xE718;"
                                  ToolTip="{DynamicResource QuickTranslate_Tip_Pin}" Click="PinButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource QtIconButton}" Content="&#xE8BB;" FontSize="10"
                            ToolTip="{DynamicResource QuickTranslate_Tip_Close}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <!-- Kaption's subtitle band (kaption.one .k-band): the game's accent on the left edge.
                     Transparent background so a click between paragraphs still counts as "close". -->
                <Border x:Name="TranslationBand" Margin="14,4,14,12" Padding="12,2,2,0" BorderThickness="3,0,0,0"
                        BorderBrush="{DynamicResource Char_Accent}">
                    <StackPanel x:Name="TranslationPanel" Background="Transparent"
                                Cursor="Hand" MouseLeftButtonUp="TranslationPanel_MouseLeftButtonUp"/>
                </Border>
            </ScrollViewer>
            <!-- The character page scrolls itself, edge to edge, so its section tabs can stay pinned. -->
            <ContentControl x:Name="OverviewHost" Grid.Row="2" Visibility="Collapsed" Focusable="False"/>

            <!-- The recognised character: portrait, name, rarity and element, the skill on screen with its type. -->
            <Border x:Name="ContextStrip" Grid.Row="3" Visibility="Collapsed" Margin="12,0,12,10" Padding="10,8,8,8"
                    CornerRadius="10" Background="{DynamicResource Char_CardBg}" BorderBrush="{DynamicResource Char_Ring}"
                    BorderThickness="1" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource Char_ChipBg}"/>
                        <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource FontDisplay}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Char_FgMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding PortraitPath, Converter={StaticResource QtMissingIcon}, ConverterParameter=36}"/>
                        <Image Source="{Binding PortraitPath, Converter={StaticResource QtIconImage}, ConverterParameter=36}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis" FontSize="13.5">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Char_Fg}"/><Run
                                 Text=" · " Foreground="{DynamicResource Char_FgSubtle}"/><Run
                                 Text="{Binding Facts, Mode=OneWay}" Foreground="{DynamicResource Char_FgMuted}"/>
                        </TextBlock>
                        <WrapPanel Margin="0,3,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Visibility="{Binding HasSkill, Converter={StaticResource QtBoolVis}}">
                                <!-- Game icons are white line art: drawn in the accent through their alpha; a glyph when absent. -->
                                <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="{Binding SkillGlyph}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4"
                                          Stroke="{DynamicResource Char_Accent}" StrokeLineJoin="Round"
                                          Visibility="{Binding SkillIconPath, Converter={StaticResource QtMissingIcon}, ConverterParameter=16}"/>
                                    <Rectangle Fill="{DynamicResource Char_Accent}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{Binding SkillIconPath, Converter={StaticResource QtIconImage}, ConverterParameter=16}"
                                                        Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                                <TextBlock Text="{Binding SkillTitle}" FontSize="12.5" Foreground="{DynamicResource Char_Fg}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3.5,8.5 L6.5,11.5 L12.5,5" Width="16" Height="16" Stretch="None" StrokeThickness="1.6"
                                      Stroke="{DynamicResource Char_Accent}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock Text="{DynamicResource QuickTranslate_Recognised}" FontSize="11.5"
                                           Foreground="{DynamicResource Char_FgSubtle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <Button x:Name="OpenCardButton" Grid.Column="2" Style="{DynamicResource KLinkButton}" Margin="10,0,0,0"
                            Focusable="True" IsTabStop="True" VerticalAlignment="Center" Click="OpenCardButton_Click"
                            Content="{DynamicResource QuickTranslate_OpenCard}"/>
                </Grid>
            </Border>

            <Border x:Name="CountdownTrack" Grid.Row="4" Height="3" Margin="12,0,12,7" CornerRadius="1.5"
                    Background="{DynamicResource Char_Track}">
                <Border x:Name="CountdownBar" HorizontalAlignment="Left" CornerRadius="1.5"
                        Background="{DynamicResource Char_Accent}" Opacity="0.8"/>
            </Border>
        </Grid>
    </Border>
</Window>
