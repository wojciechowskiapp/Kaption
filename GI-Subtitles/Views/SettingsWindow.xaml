<Window x:Class="GI_Subtitles.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:logging="clr-namespace:GI_Subtitles.Core.Logging"
        xmlns:views="clr-namespace:GI_Subtitles.Views"
        xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell"
        Title="Kaption"
        Height="780" Width="1180" MinWidth="960" MinHeight="640"
        Icon="../Resources/kaption.ico"
        Topmost="False"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource KaptionWindow}"
        ToolTipService.InitialShowDelay="300"
        ToolTipService.BetweenShowDelay="0"
        ToolTipService.ShowDuration="20000">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Legacy aliases -->
            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ModernButton}"/>
            <Style TargetType="Button" x:Key="HelpButton">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
            <Style TargetType="TextBox" x:Key="LinkTextBox">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Rows of a list inside a card: no selection chrome, a hairline between rows. -->
            <Style x:Key="PlainListItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hotkey row: what it does, a "when to use" hint, and a click-to-record chip. -->
            <DataTemplate x:Key="HotkeyRowTemplate">
                <Grid MinHeight="52" Margin="2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"/>
                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="Transparent"
                            VerticalAlignment="Center" Margin="8,0,2,0" Cursor="Help"
                            ToolTip="{Binding InfoText}" AutomationProperties.Name="{Binding InfoText}">
                        <ToolTipService.InitialShowDelay>0</ToolTipService.InitialShowDelay>
                        <ToolTipService.ShowDuration>30000</ToolTipService.ShowDuration>
                        <Path Data="{StaticResource NavIconInfo}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Content="{Binding DisplayText}"
                            MinWidth="176" Padding="14,0" Margin="6,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeSmall}"
                            Click="HotkeyChip_Click"
                            PreviewKeyDown="HotkeyChip_PreviewKeyDown"
                            LostKeyboardFocus="HotkeyChip_LostKeyboardFocus"
                            Focusable="True"
                            ToolTip="{DynamicResource Hotkey_ClickToRecord_Tooltip}"/>
                </Grid>
            </DataTemplate>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Grid>
                                <Border Background="{DynamicResource LogHeaderBgBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                                        BorderThickness="0,0,0,1" Padding="8,7">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                </Border>
                                <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <shell:TitleBar x:Name="WindowTitleBar" Title="Kaption"/>

        <!-- ═══════════════════════════════════════════════════════════
             NAVIGATION RAIL: six pages. Tags are the page ids; old tab ids
             (Regions, Translations, General, Community, Logs) map onto them
             in SettingsNavigation, so every SelectTabByTag caller still lands.
             ═══════════════════════════════════════════════════════════ -->
        <TabControl x:Name="NavTabs" Grid.Row="1" Style="{StaticResource RailTabControl}">

            <!-- ═══ START ═══ -->
            <TabItem Header="{DynamicResource shell_Nav_Home}" Tag="Dashboard" Style="{StaticResource RailTabItem}"
                     shell:NavRail.Icon="{StaticResource NavIconHome}">
                <ScrollViewer x:Name="StartScroller" Style="{StaticResource PageScroller}">
                    <!-- Start fills the window: the scroller arranges this grid at least as tall as the viewport and the
                         tiles row takes what is left, so "Zaawansowane" sits at the bottom edge with no empty band under
                         it. Taller content (an open disclosure, every notice at once) scrolls as before. -->
                    <Grid x:Name="StartLayout" MaxWidth="960" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Admin broadcasts from /api/announcements/active; collapsed when there are none. -->
                        <StackPanel x:Name="AnnouncementsStack" Visibility="Collapsed" Margin="0,0,0,4"/>

                        <!-- App update: MainWindow calls ShowUpdateBanner when the updater finds a version. -->
                        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Card}"
                                Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentSoftBrush}"
                                Padding="18,14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="UpdateBannerTitle" Text="{DynamicResource Update_Available_Title}"
                                               Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="UpdateBannerBody" Text="{DynamicResource Update_Available_Body}"
                                               Style="{StaticResource BodyText}"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="UpdateBannerInstallButton" Content="{DynamicResource Update_Install}"
                                            ToolTip="{DynamicResource Tip_Update_Install}" Click="UpdateBannerInstall_Click"
                                            Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="UpdateBannerWhatsNewButton" Content="{DynamicResource Update_WhatsNew}"
                                            ToolTip="{DynamicResource Tip_Update_WhatsNew}" Click="UpdateBannerWhatsNew_Click"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="UpdateBannerRemindButton" Content="{DynamicResource Update_RemindLater}"
                                            ToolTip="{DynamicResource Tip_Update_Remind}" Click="UpdateBannerRemind_Click"
                                            Style="{StaticResource GhostButton}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Hidden compatibility elements: code-behind still reads and writes these. -->
                        <StackPanel Grid.Row="2" Visibility="Collapsed">
                            <ComboBox Name="UILangSelector" SelectionChanged="UILangSelector_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en-US" IsSelected="True"/>
                                <ComboBoxItem Content="Polski" Tag="pl-PL"/>
                                <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                                <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            </ComboBox>
                            <ComboBox Name="InputSelector"><ComboBoxItem Content="English" IsSelected="True"/></ComboBox>
                            <ListBox Name="OutputSelector" SelectionMode="Multiple"><ListBoxItem Content="Polski" IsSelected="True"/></ListBox>
                            <Button x:Name="OutputConfirmButton" Click="OutputConfirmButton_Click"/>
                            <TextBlock Name="outputFilePathDate2"/>
                            <TextBox x:Name="InputLangDownloadUrl"/><TextBox x:Name="OutputLangDownloadUrl"/><TextBox x:Name="OutputLangDownloadUrl2"/>
                            <Button x:Name="DownloadButton1" Click="DownloadButton1_Click"/>
                            <Button x:Name="DownloadButton2" Click="DownloadButton2_Click"/>
                            <CheckBox x:Name="ShowSecondLangCheckBox" Checked="ShowSecondLangCheckBox_Checked" Unchecked="ShowSecondLangCheckBox_Checked"/>
                            <Image Name="Capture" HorizontalAlignment="Center"/>
                            <Button x:Name="SyncButton" Click="SyncButton_Click"/>
                            <Button x:Name="RestartButton" Click="RestartButton_Click"/>
                            <Button x:Name="VideoButton" Click="VideoButton_Click"/>
                            <Button x:Name="ConvertButton" Click="ConvertButton_Click"/>
                            <Button x:Name="RegionButton" Click="RegionButton_Click"/>
                            <TextBlock Name="inputFilePathDate"/><TextBlock Name="outputFilePathDate"/>
                            <TextBlock Name="RepoModifiedDate"/>
                            <ComboBox Name="GameSelector">
                                <ComboBoxItem Content="Genshin Impact" Tag="Genshin" IsSelected="True"/>
                                <ComboBoxItem Content="Honkai: Star Rail" Tag="StarRail"/>
                                <ComboBoxItem Content="Zenless Zone Zero" Tag="ZZZ"/>
                            </ComboBox>
                            <!-- No Chinese recognizer ships, so CHS stays out of the reading choice. -->
                            <ComboBox x:Name="InputLanguageCombo" SelectionChanged="InputLanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="EN" IsSelected="True"/>
                                <ComboBoxItem Content="&#x65E5;&#x672C;&#x8A9E;" Tag="JP"/>
                            </ComboBox>
                            <ComboBox x:Name="OutputLanguageCombo" SelectionChanged="OutputLanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="Polski" Tag="PL"/>
                                <ComboBoxItem Content="English" Tag="EN"/>
                                <ComboBoxItem Content="Deutsch" Tag="DE"/>
                                <ComboBoxItem Content="Español" Tag="ES"/>
                                <ComboBoxItem Content="Français" Tag="FR"/>
                                <ComboBoxItem Content="Bahasa Indonesia" Tag="ID"/>
                                <ComboBoxItem Content="&#x65E5;&#x672C;&#x8A9E;" Tag="JP"/>
                                <ComboBoxItem Content="&#xD55C;&#xAD6D;&#xC5B4;" Tag="KR"/>
                                <ComboBoxItem Content="Português" Tag="PT"/>
                                <ComboBoxItem Content="Русский" Tag="RU"/>
                                <ComboBoxItem Content="&#xE44;&#xE17;&#xE22;" Tag="TH"/>
                                <ComboBoxItem Content="Tiếng Việt" Tag="VI"/>
                                <ComboBoxItem Content="&#x7B80;&#x4F53;&#x4E2D;&#x6587;" Tag="CHS"/>
                                <ComboBoxItem Content="&#x7E41;&#x9AD4;&#x4E2D;&#x6587;" Tag="CHT"/>
                            </ComboBox>
                            <TextBlock x:Name="OutputLangRestartHint"/>
                            <TextBlock x:Name="TranslationDirectionText"/>
                            <Button x:Name="DownloadAllButton" Click="DownloadAllButton_Click"/>
                            <Label Name="Status"/>
                            <ProgressBar Name="DownloadProgressBar" Minimum="0" Maximum="100"/>
                            <TextBlock Name="DownloadSpeedText"/>
                            <!-- Answer translation is off (MainWindow.FeatureAnswerTranslationEnabled); unhide with it. -->
                            <CheckBox x:Name="EnableAnswerTranslationCheckBox" Content="{DynamicResource Settings_AnswerTranslation_Checkbox}"
                                      Checked="EnableAnswerTranslationCheckBox_Changed" Unchecked="EnableAnswerTranslationCheckBox_Changed"/>
                            <!-- Same action as Ctrl+Shift+H. -->
                            <Button x:Name="DashToggleSubtitleButton" Click="DashToggleSubtitle_Click" Content="{DynamicResource Dash_HideSubtitles}"/>
                            <CheckBox x:Name="AutoShrinkCheckBox" Content="{DynamicResource Config_AutoShrink}" IsChecked="True"
                                      Checked="AutoShrinkCheckBox_Changed" Unchecked="AutoShrinkCheckBox_Changed"/>
                            <Button Content="{DynamicResource Btn_Save}" x:Name="saveButton"/>
                            <Button Click="SecondRegion_Click"/>
                        </StackPanel>

                        <!-- ═══ STATE CARD: Kaption's subtitle band. Game accent on the left edge, the game as the
                             speaker, the state as the line, the language pair under it. One action. ═══ -->
                        <Border x:Name="StateCard" Grid.Row="3" Style="{StaticResource BandCard}" ClipToBounds="True">
                            <Grid>
                                <!-- The game's atmosphere: its ambience art (a brush, so it never sizes the card; framed on the
                                     scene's landmark by SettingsWindow.ApplyAtmosphereTo), the ink scrim that keeps the text side
                                     readable while the scene shows at about 58 % on the right, and the game's glow rising from
                                     the lower right (Genshin warm gold, Star Rail blue, ZZZ orange). -->
                                <Border CornerRadius="11" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush x:Name="StateCardArt" Stretch="UniformToFill" AlignmentY="Center"/>
                                    </Border.Background>
                                </Border>
                                <Border Background="{StaticResource BandScrimBrush}" CornerRadius="11"/>
                                <Border x:Name="StateCardGlow" CornerRadius="11" IsHitTestVisible="False"/>
                                <Border x:Name="StateCardAccent" Width="3" HorizontalAlignment="Left" Margin="0,14"
                                        CornerRadius="0,2,2,0" Background="{StaticResource GameGenshinBrush}"/>
                                <Grid Margin="28,22,22,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="StateCardText" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock x:Name="StateCardSpeaker" Style="{StaticResource BandSpeaker}"
                                                   Foreground="{StaticResource GameGenshinBrush}" Text="Genshin Impact"/>
                                        <TextBlock x:Name="StateCardTitle" Style="{StaticResource BandLine}"
                                                   Text="{DynamicResource shell_Card_Stopped}"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock x:Name="StateCardDetail" Style="{StaticResource BandSub}" Foreground="{StaticResource BandDetailBrush}"
                                                   Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock x:Name="DashActiveTranslationText" Style="{StaticResource BandSub}" Margin="0,0,14,0"
                                                       Text="English → Polski"/>
                                            <Border x:Name="StateCardOfflineNote" Style="{StaticResource BandChip}" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource BandSub}" FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource BandDetailBrush}" x:Name="StateCardOfflineText"/>
                                            </Border>
                                            <StackPanel x:Name="StateCardCpuNote" Orientation="Horizontal" Visibility="Collapsed">
                                                <Border Style="{StaticResource BandChip}">
                                                    <TextBlock Style="{StaticResource BandSub}" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource BandDetailBrush}" Text="{DynamicResource shell_Card_OnCpu}"/>
                                                </Border>
                                                <Button Style="{StaticResource BandGhostButton}" MinHeight="28" Padding="8,0"
                                                        Content="{DynamicResource shell_Action_Why}" Click="GuideSpeed_Click"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="220">
                                        <Button x:Name="DashToggleOcrButton" Style="{StaticResource PrimaryHeroButton}"
                                                Content="{DynamicResource shell_Action_Start}"
                                                ToolTip="{DynamicResource Dash_Start_Tooltip}"
                                                Click="DashToggleOcr_Click"/>
                                        <Button x:Name="DashChangeTranslationButton" Style="{StaticResource BandGhostButton}"
                                                Content="{DynamicResource shell_Action_ChangeGame}"
                                                ToolTip="{DynamicResource Dash_ChangeTranslation_Tooltip}"
                                                Click="DashChangeTranslation_Click" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="StateCardProgress" Style="{StaticResource ModernProgressBar}" Height="3"
                                             VerticalAlignment="Bottom" Margin="1,0,1,1" Minimum="0" Maximum="1"
                                             Background="Transparent" Foreground="{StaticResource GameGenshinBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- The one-time Genshin display-mode tip (the start gate shows it here instead of a modal). -->
                        <Border x:Name="DisplayModeCard" Grid.Row="4" Visibility="Collapsed" Style="{StaticResource Callout}"
                                Background="{DynamicResource WarnLightBrush}" Margin="0,12,0,0" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="None" VerticalAlignment="Top" Margin="0,2,12,0"
                                      Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource shell_DisplayMode_Title}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{DynamicResource onb_DisplayMode}" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextBrush}"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource onb_DisplayMode_Link}" Click="GuideBorderless_Click"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource ModernButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Content="{DynamicResource onb_DisplayMode_Ok}" Click="DisplayModeOk_Click"/>
                            </Grid>
                        </Border>

                        <!-- Returning users, once: what 2.5 changes, with the auto-start switch right there. New installs
                             learn it in the setup window and never see this card. -->
                        <Border x:Name="Intro25Card" Grid.Row="5" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Margin="0,14" CornerRadius="0,2,2,0" Background="{StaticResource BrandGradientBrush}"/>
                                <StackPanel Grid.Column="1" Margin="18,14,16,14">
                                    <TextBlock Style="{StaticResource Eyebrow}" shell:Typo.Eyebrow="{DynamicResource shell_Intro25_Eyebrow}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource shell_Intro25_Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{DynamicResource shell_Intro25_Body}" Style="{StaticResource HintText}"/>
                                    <CheckBox x:Name="Intro25AutoToggle" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0" IsChecked="True"
                                              HorizontalAlignment="Left" Checked="Intro25AutoToggle_Changed" Unchecked="Intro25AutoToggle_Changed"
                                              AutomationProperties.Name="{DynamicResource shell_AutoStart_Toggle}">
                                        <TextBlock Text="{DynamicResource shell_AutoStart_Toggle}" Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    </CheckBox>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{DynamicResource shell_Intro25_Ok}"
                                        Click="Intro25Ok_Click" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            </Grid>
                        </Border>

                        <!-- A shortcut Windows refused because another app holds it. -->
                        <Border x:Name="HotkeyConflictStrip" Grid.Row="6" Visibility="Collapsed" Style="{StaticResource Callout}"
                                Background="{DynamicResource WarnLightBrush}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="None" VerticalAlignment="Center"
                                      Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,10,0"/>
                                <TextBlock x:Name="HotkeyConflictStripText" Grid.Column="1" Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                        Content="{DynamicResource shell_Action_ChangeHotkey}" Click="GoToHotkeys_Click"/>
                            </Grid>
                        </Border>

                        <!-- ═══ Row 2: packs and shortcuts side by side, stretching to the bottom of the window; each tile's
                             link sits on its bottom edge. The reader moved to the status bar ("GPU · PP-OCRv6"). ═══ -->
                        <Grid x:Name="StartTiles" Grid.Row="7" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="PacksTile" Style="{StaticResource Card}" Margin="0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Packs_Title}" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="PacksCardSkeleton" DockPanel.Dock="Top">
                                        <Border Style="{StaticResource SkeletonBar}" Width="220" Margin="0,8,0,14"/>
                                        <Border Style="{StaticResource SkeletonBar}" Width="190" Margin="0,0,0,14"/>
                                        <Border Style="{StaticResource SkeletonBar}" Width="240" Margin="0,0,0,6"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="PacksCardList" DockPanel.Dock="Top" Visibility="Collapsed" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- One line: game · version · state; a newer pack is the inline link. -->
                                                <Grid MinHeight="36" ToolTip="{Binding Tooltip}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Accent}"/>
                                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="versionSep" Text="·" Margin="7,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <TextBlock x:Name="version" Text="{Binding Version}" FontSize="{StaticResource FontSizeBody}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="statusSep" Text="·" Margin="7,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <TextBlock x:Name="statusText" Text="{Binding Status}" VerticalAlignment="Center"
                                                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusBrush}"/>
                                                        <Button x:Name="statusLink" Style="{StaticResource LinkButton}" Visibility="Collapsed"
                                                                Content="{Binding Status}" Tag="{Binding}" Click="PackRowDownload_Click"
                                                                FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" ToolTip="{Binding Tooltip}"/>
                                                    </WrapPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownload}" Value="True">
                                                        <Setter TargetName="statusText" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="statusLink" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Version}" Value="">
                                                        <Setter TargetName="versionSep" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="version" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="">
                                                        <Setter TargetName="statusSep" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="statusText" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Content="{DynamicResource start_Packs_All}" Click="GoToPacks_Click"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="HotkeysTile" Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Hotkeys_Title}" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="HotkeysCardList" DockPanel.Dock="Top" ItemTemplate="{StaticResource HotkeyCapsRow}" Focusable="False"/>
                                    <!-- Karta buildu: the player's UID read off the game screen (or remembered), then the card maker on
                                         kaption.one (SettingsWindow.BuildCard.cs). The line under it says when the UID could not be read. -->
                                    <Button x:Name="BuildCardTile" DockPanel.Dock="Top" Style="{StaticResource ShortcutTile}" Margin="0,10,0,0"
                                            Click="BuildCard_Click" ToolTip="{DynamicResource card_Entry_Tip}"
                                            AutomationProperties.Name="{DynamicResource card_Title}"
                                            AutomationProperties.HelpText="{DynamicResource card_Entry_Hint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCard}" Width="16" Height="16" Stretch="None" StrokeThickness="1.6"
                                                      Stroke="{DynamicResource AccentTextBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource card_Title}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{DynamicResource card_Entry_Hint}" Style="{StaticResource HintText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Path Grid.Column="2" Data="{StaticResource IconExternal}" Width="16" Height="16" Stretch="None" StrokeThickness="1.6"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock x:Name="BuildCardNote" DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="2,8,0,0"
                                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Content="{DynamicResource shell_Action_AllHotkeys}" Click="GoToHotkeys_Click"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ═══ What's new: only when the newest release note is newer than the last one dismissed. ═══ -->
                        <Border x:Name="WhatsNewCard" Grid.Row="8" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="WhatsNewAccent" Margin="0,14" CornerRadius="0,2,2,0" Background="{StaticResource GameGenshinBrush}"/>
                                <StackPanel Grid.Column="1" Margin="18,14,12,14">
                                    <TextBlock Style="{StaticResource Eyebrow}" shell:Typo.Eyebrow="{DynamicResource shell_WhatsNew_Title}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="WhatsNewTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="WhatsNewMeta" Style="{StaticResource HintText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource shell_Action_ReadMore}"
                                            Click="WhatsNewOpen_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource IconButton}" Click="WhatsNewDismiss_Click"
                                            ToolTip="{DynamicResource shell_Action_Dismiss}" AutomationProperties.Name="{DynamicResource shell_Action_Dismiss}">
                                        <Path Data="{StaticResource IconClose}" Width="16" Height="16" Stretch="None" StrokeThickness="1.6"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Technical details for advanced users: what runs where, which revisions, how fast. Under them the
                             build card's memory: the UID kept per game, and the small action that forgets it. -->
                        <Expander x:Name="HomeAdvancedExpander" Grid.Row="9" Style="{StaticResource AdvancedExpander}" Margin="0,20,0,0"
                                  Header="{DynamicResource shell_Advanced}" Expanded="AdvancedExpander_Changed" Collapsed="AdvancedExpander_Changed">
                            <StackPanel>
                                <TextBlock x:Name="HomeAdvancedDetails" Style="{StaticResource HintText}" FontFamily="{StaticResource FontMono}"
                                           Margin="2,4,0,0" LineHeight="19"/>
                                <Grid x:Name="BuildCardMemoryRow" Margin="2,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource card_Title}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="BuildCardMemoryText" Style="{StaticResource HintText}" Margin="0,2,0,0"
                                                   Text="{DynamicResource card_Memory_None}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                    <Button x:Name="BuildCardForgetButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                            Content="{DynamicResource card_Forget}" ToolTip="{DynamicResource card_Forget_Tip}"
                                            Click="BuildCardForget_Click" IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ GRA I NAPISY: game, language pair, packs, dialogue area ═══ -->
            <TabItem Header="{DynamicResource shell_Nav_Game}" Tag="Game" Style="{StaticResource RailTabItem}"
                     shell:NavRail.Icon="{StaticResource NavIconGame}">
                <ScrollViewer x:Name="GamePageScroller" Style="{StaticResource PageScroller}">
                    <StackPanel Style="{StaticResource PageContent}">
                        <TextBlock Style="{StaticResource PageHeading}" Text="{DynamicResource shell_Page_Game_Title}"/>
                        <TextBlock Style="{StaticResource PageLead}" Text="{DynamicResource shell_Page_Game_Lead}"/>

                        <!-- Game and the language it is played in. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Game_Card_Title}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="GamePillGenshin" Tag="Genshin" Style="{StaticResource SecondaryButton}"
                                            Content="Genshin Impact" MinWidth="140" Padding="14,0" Margin="0,0,8,8"
                                            Click="TranslationsGamePill_Click" ToolTip="{DynamicResource Tip_Translations_Game}"/>
                                    <Button x:Name="GamePillStarRail" Tag="StarRail" Style="{StaticResource SecondaryButton}"
                                            Content="Honkai: Star Rail" MinWidth="140" Padding="14,0" Margin="0,0,8,8"
                                            Click="TranslationsGamePill_Click" ToolTip="{DynamicResource Tip_Translations_Game}"/>
                                    <Button x:Name="GamePillZZZ" Tag="ZZZ" Style="{StaticResource SecondaryButton}"
                                            Content="Zenless Zone Zero" MinWidth="140" Padding="14,0" Margin="0,0,8,8"
                                            Click="TranslationsGamePill_Click" ToolTip="{DynamicResource Tip_Translations_Game}"/>
                                </WrapPanel>
                                <TextBlock Text="{DynamicResource shell_Game_SwitchRestarts}" FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <!-- Another supported game is on screen: one click to switch to it. -->
                                <Border x:Name="GameDetectedHint" Visibility="Collapsed" Style="{StaticResource Callout}"
                                        Background="{DynamicResource InfoLightBrush}" Margin="0,4,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GameDetectedText" Style="{StaticResource BodyText}"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <Button x:Name="GameDetectedSwitch" Grid.Column="1" Style="{StaticResource LinkButton}"
                                                Margin="12,0,0,0" Click="GameDetectedSwitch_Click"/>
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource shell_Game_Reading}" Margin="0,8,0,8"/>
                                <WrapPanel>
                                    <!-- The recognizers that ship: English and Japanese (no Chinese model yet). -->
                                    <Button x:Name="InputPillEN" Tag="EN" Style="{StaticResource SecondaryButton}" Content="English"
                                            MinWidth="96" Padding="14,0" Margin="0,0,8,0"
                                            Click="TranslationsInputPill_Click" ToolTip="{DynamicResource Tip_Translations_ReadingEN}"/>
                                    <Button x:Name="InputPillJP" Tag="JP" Style="{StaticResource SecondaryButton}" Content="&#x65E5;&#x672C;&#x8A9E;"
                                            MinWidth="96" Padding="14,0"
                                            Click="TranslationsInputPill_Click" ToolTip="{DynamicResource Tip_Translations_ReadingJP}"/>
                                    <Button x:Name="InputPillCHS" Tag="CHS" Visibility="Collapsed" Style="{StaticResource SecondaryButton}"
                                            Content="&#x7B80;&#x4F53;&#x4E2D;&#x6587;" MinWidth="96" Padding="14,0"
                                            Click="TranslationsInputPill_Click"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Translations_Hint}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Packs for the selected game: status per language, one action per row. -->
                        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <Grid Margin="20,16,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Packs_Title}" VerticalAlignment="Center" Margin="0"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="TranslationsRefresh_Click"
                                            ToolTip="{DynamicResource Translations_Rescan_Tooltip}"
                                            AutomationProperties.Name="{DynamicResource Translations_Rescan_Tooltip}">
                                        <Path Data="{StaticResource IconRetry}" Width="16" Height="16" Stretch="None" StrokeThickness="1.6"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Button>
                                </Grid>
                                <!-- Shown only when the server catalogue could not be read. -->
                                <Border x:Name="TranslationsNoticeBanner" Visibility="Collapsed" Style="{StaticResource Callout}"
                                        Background="{DynamicResource WarnLightBrush}" Margin="20,0,20,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="None" VerticalAlignment="Top"
                                              Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,1,8,0"/>
                                        <TextBlock x:Name="TranslationsNoticeText" Style="{StaticResource BodyText}"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Loading: skeleton rows until the first scan answers. -->
                                <StackPanel x:Name="TranslationsLoading" Margin="20,4,20,16">
                                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource shell_Loading_Packs}" Margin="0,0,0,12"/>
                                    <Border Style="{StaticResource SkeletonBar}" Width="220" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource SkeletonBar}" Width="320" Height="10" Margin="0,0,0,18"/>
                                    <Border Style="{StaticResource SkeletonBar}" Width="200" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource SkeletonBar}" Width="280" Height="10"/>
                                </StackPanel>
                                <!-- Empty: one sentence, one action (the shared state component). -->
                                <shell:StateMessage x:Name="TranslationsEmptyState" Visibility="Collapsed" Margin="20,18,20,24"
                                                    Icon="{StaticResource NavIconDownload}" Text="{DynamicResource state_Packs_Empty}"
                                                    ActionText="{DynamicResource state_CheckAgain}" ActionClick="TranslationsRefresh_Click"/>
                                <ListView x:Name="TranslationsList" Background="Transparent" BorderThickness="0" MaxHeight="420"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                                          Foreground="{DynamicResource TextBrush}">
                                    <ListView.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource LogHeaderBgBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                                                            BorderThickness="0,1,0,1" Padding="20,6,20,6">
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListView.GroupStyle>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainListItem}"/>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <!-- One line: [accent] language · version · state · "W użyciu" … size [action]. Where the pack
                                                 came from (and its file) is the row's tooltip, not a sentence on the row. -->
                                            <Grid MouseLeftButtonUp="TranslationsPackRow_MouseLeftButtonUp" Background="Transparent" Cursor="Hand"
                                                  MinHeight="54" ToolTip="{Binding RowTooltip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding IsActiveTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <WrapPanel Grid.Column="1" Margin="17,10,0,10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LanguageDisplayName}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="versionSep" Text="·" Margin="8,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    <TextBlock x:Name="version" Text="{Binding VersionLabel, Mode=OneWay}" VerticalAlignment="Center"
                                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <Border CornerRadius="10" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source}" Value="LocalCache">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="PaidCached">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="RemoteAvailable">
                                                                        <Setter Property="Background" Value="{DynamicResource InfoLightBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source}" Value="RemoteLocked">
                                                                        <Setter Property="Background" Value="{DynamicResource ErrorLightBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source}" Value="LocalCache">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="PaidCached">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="RemoteAvailable">
                                                                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="RemoteLocked">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding ActiveLabel}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Margin="10,0,0,0"
                                                               Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                                               Visibility="{Binding IsActiveTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </WrapPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" FontSize="{StaticResource FontSizeSmall}" Margin="14,0,12,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Button Style="{StaticResource ModernButton}" Content="{DynamicResource Translations_Update_Button}" Tag="{Binding}"
                                                            Click="TranslationsSyncPack_Click" MinWidth="96" Margin="0,0,6,0"
                                                            ToolTip="{Binding RemoteVersion}"
                                                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Button Style="{StaticResource ModernButton}" Content="{DynamicResource Translations_Download_Button}" Tag="{Binding}"
                                                            Click="TranslationsDownloadPack_Click" MinWidth="96" Margin="0"
                                                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Translations_OpenFolder_Button}"
                                                            Tag="{Binding LocalPath}" Click="TranslationsOpenFolder_Click"
                                                            Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding VersionLabel}" Value="">
                                                    <Setter TargetName="versionSep" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="version" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Auto-start: on by default; the switch is on the page, not behind Zaawansowane. -->
                        <Border x:Name="AutoTranslateCard" Style="{StaticResource Card}">
                            <CheckBox x:Name="AutoTranslateToggle" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                      Checked="AutoTranslateToggle_Changed" Unchecked="AutoTranslateToggle_Changed">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource shell_AutoStart_Toggle}" FontSize="{StaticResource FontSizeCardTitle}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource shell_AutoStart_Hint}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Dialogue area: what Kaption reads, shown as a live thumbnail on its monitor. -->
                        <Border x:Name="RegionCard" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="272" Height="153" CornerRadius="8" Background="{DynamicResource Ink950Brush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top">
                                    <Grid>
                                        <Image x:Name="RegionPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               AutomationProperties.Name="{DynamicResource shell_Region_Title}"/>
                                        <TextBlock x:Name="RegionPreviewEmpty" Text="{DynamicResource shell_Region_Preview_None}"
                                                   Foreground="{StaticResource BandSubBrush}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                                                   TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Region_Title}"/>
                                    <TextBlock x:Name="RegionMonitorText" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DashRegionInfo" Style="{StaticResource BodyText}"
                                               Text="{DynamicResource Dash_Region_NotSet}" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Button x:Name="DashAutoDetectButton" Style="{StaticResource ModernButton}"
                                                Content="{DynamicResource shell_Region_Detect}" ToolTip="{DynamicResource Tip_Region_AutoDetect}"
                                                Click="DashAutoDetect_Click" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource shell_Region_Fix}"
                                                ToolTip="{DynamicResource Tip_Region_Select}" Click="DashSelectRegion_Click" Margin="0,0,8,8"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource shell_Region_Show}"
                                                ToolTip="{DynamicResource Tip_Region_Show}" Click="DashShowRegion_Click" Margin="0,0,8,8"/>
                                        <!-- Answer-region button; shown only when FeatureAnswerTranslationEnabled. -->
                                        <Button x:Name="DashSelectAnswerRegionButton" Style="{StaticResource SecondaryButton}"
                                                Content="{DynamicResource Regions_Answer_Button}" Click="DashSelectAnswerRegion_Click"
                                                Margin="0,0,8,8" Visibility="Collapsed" ToolTip="{DynamicResource Regions_Answer_Tooltip}"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="DashAutoDetectStatus" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource shell_Region_Guide}"
                                            Click="GuideRegion_Click" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ═══ Zaawansowane ═══ -->
                        <Expander x:Name="GameAdvancedExpander" Style="{StaticResource AdvancedExpander}" Header="{DynamicResource shell_Advanced}"
                                  Expanded="AdvancedExpander_Changed" Collapsed="AdvancedExpander_Changed">
                            <StackPanel Margin="0,4,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Startup_Title}" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="AutoStartCheckBox" Style="{StaticResource ModernCheckBox}"
                                                  Content="{DynamicResource Config_AutoStart}" ToolTip="{DynamicResource Tip_Settings_AutoStart}"
                                                  Checked="AutoStartCheckBox_Checked" Unchecked="AutoStartCheckBox_Checked"/>
                                        <CheckBox x:Name="AutoTranslateFocusCheck" Style="{StaticResource ModernCheckBox}" Margin="0,12,0,0" IsChecked="True"
                                                  Content="{DynamicResource shell_AutoStart_Focus}" ToolTip="{DynamicResource shell_AutoStart_FocusHint}"
                                                  Checked="AutoTranslateFocus_Changed" Unchecked="AutoTranslateFocus_Changed"/>
                                        <TextBlock Text="{DynamicResource shell_AutoStart_FocusHint}" Style="{StaticResource HintText}" Margin="28,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings_PlayerName_Card_Label}"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Settings_PlayerName_Card_Body}" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Settings_PlayerName_Label}" Margin="0,0,12,0"/>
                                            <TextBox x:Name="PlayerNameTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                     HorizontalAlignment="Left" Width="280"
                                                     ToolTip="{DynamicResource Settings_PlayerName_Tooltip}"
                                                     LostFocus="PlayerNameTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Exact capture rectangle in screen pixels, for people who know what they want. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Region_Coords}" Margin="0,0,0,12"/>
                                        <WrapPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                                <TextBlock Text="X" Style="{StaticResource FieldLabel}" Width="16"/>
                                                <TextBox x:Name="RegionX" Style="{StaticResource ModernTextBox}" Width="76" Text="763" TextAlignment="Center"
                                                         AutomationProperties.Name="X" LostFocus="RegionField_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                                <TextBlock Text="Y" Style="{StaticResource FieldLabel}" Width="16"/>
                                                <TextBox x:Name="RegionY" Style="{StaticResource ModernTextBox}" Width="76" Text="1797" TextAlignment="Center"
                                                         AutomationProperties.Name="Y" LostFocus="RegionField_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                                <TextBlock Text="W" Style="{StaticResource FieldLabel}" Width="18"/>
                                                <TextBox x:Name="RegionWidth" Style="{StaticResource ModernTextBox}" Width="76" Text="2226" TextAlignment="Center"
                                                         AutomationProperties.Name="W" LostFocus="RegionField_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                                <TextBlock Text="H" Style="{StaticResource FieldLabel}" Width="16"/>
                                                <TextBox x:Name="RegionHeight" Style="{StaticResource ModernTextBox}" Width="76" Text="110" TextAlignment="Center"
                                                         AutomationProperties.Name="H" LostFocus="RegionField_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource shell_Region_Show}"
                                                    ToolTip="{DynamicResource Config_PreviewRegion_Tooltip}" Click="PreviewRegion_Click" Margin="0,0,0,6"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Per-game reading pace (GameOcrTuning): a value here pins it for every game. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Pacing_Title}" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Config_OcrInterval}" Style="{StaticResource FieldLabel}" Width="170"/>
                                            <TextBox x:Name="OcrIntervalTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="100" TextAlignment="Center"
                                                     ToolTip="{DynamicResource Tip_Settings_OcrInterval}"
                                                     LostFocus="OcrIntervalTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            <TextBlock Text="ms" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Config_UiRefresh}" Style="{StaticResource FieldLabel}" Width="170"/>
                                            <TextBox x:Name="UiRefreshTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="150" TextAlignment="Center"
                                                     ToolTip="{DynamicResource Tip_Settings_OcrRefresh}"
                                                     LostFocus="UiRefreshTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            <TextBlock Text="ms" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Settings_StabilityWindow_Label}" Style="{StaticResource FieldLabel}" Width="170"/>
                                            <TextBox x:Name="StabilityWindowTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="4" TextAlignment="Center"
                                                     ToolTip="{DynamicResource Tip_Settings_OcrStability}"
                                                     LostFocus="StabilityWindowTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            <TextBlock Text="{DynamicResource Settings_Frames_Unit}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Config_OcrSpeed_Hint}" Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ WYGLĄD NAPISÓW: the subtitle shown live, three looks, size and place; the Ctrl+Q window; the app's own look ═══ -->
            <TabItem Header="{DynamicResource shell_Nav_Look}" Tag="Appearance" Style="{StaticResource RailTabItem}"
                     shell:NavRail.Icon="{StaticResource NavIconSubtitles}">
                <ScrollViewer Style="{StaticResource PageScroller}">
                    <StackPanel Style="{StaticResource PageContent}">
                        <TextBlock Style="{StaticResource PageHeading}" Text="{DynamicResource shell_Page_Look_Title}"/>
                        <TextBlock Style="{StaticResource PageLead}" Text="{DynamicResource look_Lead}"/>

                        <!-- The user's real screen to scale (the game window when it is open): the saved dialogue area and the
                             overlay's own panel where and as large as the app draws them; the looks beside it (under it on a
                             narrow window); the same panel at 1:1 below. Code: SettingsWindow.Look.cs. -->
                        <shell:SideOrBelowPanel SideMinWidth="260" Gap="16" Margin="0,0,0,12">
                            <StackPanel>
                                <shell:SubtitlePreview x:Name="LookPreview"
                                                       Speaker="{DynamicResource look_Sample_Speaker}" Line="{DynamicResource look_Sample_Line}"
                                                       AutomationProperties.HelpText="{DynamicResource look_Preview_Help}"
                                                       ToolTip="{DynamicResource look_Preview_Help}" ToolTipService.InitialShowDelay="900"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource look_Preview_Hint}" Margin="2,8,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" shell:Typo.Eyebrow="{DynamicResource look_Presets_Title}"/>
                                <views:AdaptiveGrid x:Name="LookPresets" MinColumnWidth="200" MaxColumns="3" ColumnGap="10" RowGap="10"
                                                    AutomationProperties.Name="{DynamicResource look_Presets_Title}">
                                    <RadioButton x:Name="PresetClassic" GroupName="OverlayPreset" Tag="Classic" Style="{StaticResource PresetCard}"
                                                 Checked="LookPreset_Checked" AutomationProperties.Name="{DynamicResource look_Preset_Classic}"
                                                 AutomationProperties.HelpText="{DynamicResource look_Preset_Classic_Hint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <shell:PresetSwatch x:Name="SwatchClassic" Preset="Classic" Sample="{DynamicResource look_Sample_Short}" Height="58"/>
                                            <StackPanel Grid.Column="1" Margin="12,2,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource look_Preset_Classic}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{DynamicResource look_Preset_Classic_Hint}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton x:Name="PresetContrast" GroupName="OverlayPreset" Tag="Contrast" Style="{StaticResource PresetCard}"
                                                 Checked="LookPreset_Checked" AutomationProperties.Name="{DynamicResource look_Preset_Contrast}"
                                                 AutomationProperties.HelpText="{DynamicResource look_Preset_Contrast_Hint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <shell:PresetSwatch x:Name="SwatchContrast" Preset="Contrast" Sample="{DynamicResource look_Sample_Short}" Height="58"/>
                                            <StackPanel Grid.Column="1" Margin="12,2,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource look_Preset_Contrast}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{DynamicResource look_Preset_Contrast_Hint}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton x:Name="PresetCinema" GroupName="OverlayPreset" Tag="Cinema" Style="{StaticResource PresetCard}"
                                                 Checked="LookPreset_Checked" AutomationProperties.Name="{DynamicResource look_Preset_Cinema}"
                                                 AutomationProperties.HelpText="{DynamicResource look_Preset_Cinema_Hint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <shell:PresetSwatch x:Name="SwatchCinema" Preset="Cinema" Sample="{DynamicResource look_Sample_Short}" Height="58"/>
                                            <StackPanel Grid.Column="1" Margin="12,2,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource look_Preset_Cinema}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{DynamicResource look_Preset_Cinema_Hint}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </RadioButton>
                                </views:AdaptiveGrid>
                                <Button x:Name="LookResetButton" Style="{StaticResource LinkButton}" Content="{DynamicResource look_Reset}"
                                        Click="LookReset_Click" Margin="2,8,0,0" ToolTip="{DynamicResource look_Reset_Tip}"/>
                            </StackPanel>
                        </shell:SideOrBelowPanel>

                        <!-- Podgląd 1:1: the same panel at its true size, for size, face and look. -->
                        <shell:SubtitleTrueSize x:Name="LookTrueSize" Margin="0,0,0,16" Label="{DynamicResource look_TrueSize}"
                                                Speaker="{DynamicResource look_Sample_Speaker}" Line="{DynamicResource look_Sample_Line}"
                                                ToolTip="{DynamicResource look_TrueSize_Tip}"/>

                        <!-- Size and place: the value sits on each thumb; exact numbers are under Zaawansowane. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource look_Size_Title}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource look_Size}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Slider x:Name="FontSizeSlider" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="10" Maximum="36" Value="22"
                                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                            AutomationProperties.Name="{DynamicResource look_Size}"
                                            ToolTip="{DynamicResource Tip_Appearance_FontSize}" ValueChanged="FontSizeSlider_ValueChanged"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource look_Vertical}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Slider x:Name="PadVerticalSlider" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="-500" Maximum="500" Value="-175"
                                            TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                            AutomationProperties.Name="{DynamicResource look_Vertical}"
                                            ToolTip="{DynamicResource Tip_Appearance_VertPad}" ValueChanged="PadVerticalSlider_ValueChanged"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource look_Horizontal}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Slider x:Name="PadHorizontalSlider" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="-500" Maximum="500" Value="0"
                                            TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                            AutomationProperties.Name="{DynamicResource look_Horizontal}"
                                            ToolTip="{DynamicResource Tip_Appearance_HorizPad}" ValueChanged="PadHorizontalSlider_ValueChanged"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource look_Move_Hint}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- The Ctrl+Q window (code in SettingsWindow.QuickTranslate.cs), with a small picture of it. -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings_QuickTranslate_Card_Label}"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Settings_QuickTranslate_Card_Body}" Margin="0,0,0,12"/>
                                    <RadioButton x:Name="QuickTranslateModeAuto" GroupName="QuickTranslateMode" Tag="Auto"
                                                 Content="{DynamicResource Settings_QuickTranslate_Mode_Auto}" Checked="QuickTranslateMode_Checked"/>
                                    <RadioButton x:Name="QuickTranslateModeTimed" GroupName="QuickTranslateMode" Tag="Timed"
                                                 Content="{DynamicResource Settings_QuickTranslate_Mode_Timed}" Checked="QuickTranslateMode_Checked"/>
                                    <Grid x:Name="QuickTranslateSecondsRow" Margin="28,0,0,4" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="122"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_QuickTranslate_Seconds_Label}" Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                                        <Slider x:Name="QuickTranslateSecondsSlider" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="2" Maximum="120"
                                                TickFrequency="1" IsSnapToTickEnabled="True" shell:SliderValue.Format="{}{0:0} s"
                                                AutomationProperties.Name="{DynamicResource Settings_QuickTranslate_Seconds_Label}"
                                                ValueChanged="QuickTranslateSecondsSlider_ValueChanged"/>
                                    </Grid>
                                    <TextBlock x:Name="QuickTranslateSecondsValue" Visibility="Collapsed"/>
                                    <RadioButton x:Name="QuickTranslateModeManual" GroupName="QuickTranslateMode" Tag="Manual"
                                                 Content="{DynamicResource Settings_QuickTranslate_Mode_Manual}" Margin="0,0,0,8"
                                                 Checked="QuickTranslateMode_Checked"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_QuickTranslate_FontSize_Label}" Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                                        <Slider x:Name="QuickTranslateFontSlider" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="12" Maximum="28"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                AutomationProperties.Name="{DynamicResource Settings_QuickTranslate_FontSize_Label}"
                                                ValueChanged="QuickTranslateFontSlider_ValueChanged"/>
                                    </Grid>
                                    <TextBlock x:Name="QuickTranslateFontValue" Visibility="Collapsed"/>
                                    <TextBlock Text="{DynamicResource Settings_QuickTranslate_Hint}" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- A small picture of the popup: always dark like the real one, its text at the chosen size. -->
                                <Border x:Name="QuickTranslatePreview" Grid.Column="1" Width="264" VerticalAlignment="Top" Margin="0,4,0,0"
                                        Background="{StaticResource BandBgBrush}" BorderBrush="{StaticResource BandHairlineBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,10,14,12" SnapsToDevicePixels="True"
                                        AutomationProperties.Name="{DynamicResource look_Qt_Preview_Name}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource look_Qt_Preview_Title}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BandSubBrush}" VerticalAlignment="Center"/>
                                            <Path Grid.Column="1" Data="{StaticResource IconClose}" Width="16" Height="16" Stretch="None"
                                                  Stroke="{StaticResource BandSubBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource look_Qt_Preview_Line}" TextWrapping="Wrap" Foreground="{StaticResource BandTextBrush}"
                                                   FontSize="{Binding Value, ElementName=QuickTranslateFontSlider}"/>
                                        <Border x:Name="QuickTranslatePreviewTimer" Height="3" CornerRadius="1.5" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Width="148" Background="{StaticResource BandAccentBrush}" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Kaption's own look: theme and interface language. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Look_App}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource shell_Theme_Label}" Style="{StaticResource FieldLabel}"/>
                                    <WrapPanel Grid.Column="1" AutomationProperties.Name="{DynamicResource shell_Theme_Label}">
                                        <RadioButton x:Name="ThemeAutoRadio" Style="{StaticResource SegmentRadio}" GroupName="AppTheme" Tag="Auto"
                                                     Content="{DynamicResource shell_Theme_Auto}" Checked="ThemeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource SegmentRadio}" GroupName="AppTheme" Tag="Dark"
                                                     Content="{DynamicResource shell_Theme_Dark}" Checked="ThemeRadio_Checked"/>
                                        <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource SegmentRadio}" GroupName="AppTheme" Tag="Light"
                                                     Content="{DynamicResource shell_Theme_Light}" Checked="ThemeRadio_Checked"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBlock Text="{DynamicResource shell_Theme_Hint}" Style="{StaticResource HintText}" Margin="170,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource shell_Look_AppLanguage}" Style="{StaticResource FieldLabel}"/>
                                    <!-- Polish and English only; ja/zh dictionaries stay for legacy configs but are not offered. -->
                                    <ComboBox x:Name="UILangCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="220"
                                              HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource shell_Look_AppLanguage}"
                                              SelectionChanged="UILangCombo_SelectionChanged">
                                        <ComboBoxItem Content="Polski" Tag="pl-PL"/>
                                        <ComboBoxItem Content="English" Tag="en-US"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="LookAdvancedExpander" Style="{StaticResource AdvancedExpander}" Header="{DynamicResource shell_Advanced}"
                                  Expanded="AdvancedExpander_Changed" Collapsed="AdvancedExpander_Changed">
                            <StackPanel Margin="0,4,0,0">
                                <!-- Exact numbers for the sliders above. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource look_Exact_Title}" Margin="0,0,0,12"/>
                                        <WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                                <TextBlock Text="{DynamicResource look_Size}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                                <TextBox x:Name="FontSizeTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="22"
                                                         TextAlignment="Center" ToolTip="{DynamicResource Tip_Appearance_FontSize}"
                                                         AutomationProperties.Name="{DynamicResource look_Size}"
                                                         LostFocus="FontSizeTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                                <TextBlock Text="{DynamicResource look_Vertical}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                                <TextBox x:Name="PadTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="-175"
                                                         TextAlignment="Center" ToolTip="{DynamicResource Tip_Appearance_VertPad}"
                                                         AutomationProperties.Name="{DynamicResource look_Vertical}"
                                                         LostFocus="PadTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource look_Horizontal}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                                <TextBox x:Name="PadHorizontalTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="0"
                                                         TextAlignment="Center" ToolTip="{DynamicResource Tip_Appearance_HorizPad}"
                                                         AutomationProperties.Name="{DynamicResource look_Horizontal}"
                                                         LostFocus="PadHorizontalTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                                <TextBlock Text="{DynamicResource look_MaxHeight}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                                <TextBox x:Name="MaxHeightTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="Auto"
                                                         TextAlignment="Center" ToolTip="{DynamicResource Tip_Appearance_MaxHeight}"
                                                         AutomationProperties.Name="{DynamicResource look_MaxHeight}"
                                                         LostFocus="MaxHeightTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource look_MaxWidth}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                                <TextBox x:Name="MaxWidthTextBox" Style="{StaticResource ModernTextBox}" Width="76" Text="Auto"
                                                         TextAlignment="Center" ToolTip="{DynamicResource Tip_Appearance_MaxWidth}"
                                                         AutomationProperties.Name="{DynamicResource look_MaxWidth}"
                                                         LostFocus="MaxWidthTextBox_LostFocus" KeyDown="TextBox_KeyDown"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- How far the subtitles may grow; Auto (the slider at its start) lets Kaption pick from the screen. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource look_Limits_Title}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource look_MaxHeight}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <Slider x:Name="MaxHeightSlider" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="100" Maximum="600" Value="100"
                                                    TickFrequency="10" IsSnapToTickEnabled="True" shell:SliderValue.AutoText="{DynamicResource look_Auto}"
                                                    AutomationProperties.Name="{DynamicResource look_MaxHeight}"
                                                    ToolTip="{DynamicResource Tip_Appearance_MaxHeight}" ValueChanged="MaxHeightSlider_ValueChanged"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource look_MaxWidth}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <Slider x:Name="MaxWidthSlider" Grid.Column="1" Style="{StaticResource ValueSlider}" Minimum="200" Maximum="1400" Value="200"
                                                    TickFrequency="10" IsSnapToTickEnabled="True" shell:SliderValue.AutoText="{DynamicResource look_Auto}"
                                                    AutomationProperties.Name="{DynamicResource look_MaxWidth}"
                                                    ToolTip="{DynamicResource Tip_Appearance_MaxWidth}" ValueChanged="MaxWidthSlider_ValueChanged"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource Config_DisplayZone_Hint}" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- The face and the panel. -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource look_Face_Title}" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource shell_Look_Font}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="FontFamilyComboBox" Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="280"
                                                      HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource shell_Look_Font}"
                                                      ToolTip="{DynamicResource Tip_Appearance_Font}" SelectionChanged="FontFamilyComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource look_Font_Default}" Tag="Source Sans 3" IsSelected="True"/>
                                                <ComboBoxItem Content="Inter Tight" Tag="Inter Tight"/>
                                                <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                                                <ComboBoxItem Content="Arial" Tag="Arial"/>
                                                <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                                                <ComboBoxItem Content="Verdana" Tag="Verdana"/>
                                                <ComboBoxItem Content="Tahoma" Tag="Tahoma"/>
                                                <ComboBoxItem Content="Trebuchet MS" Tag="Trebuchet MS"/>
                                                <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                                            </ComboBox>
                                        </Grid>
                                        <CheckBox x:Name="AutoDarkenToggle" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                                  Checked="AutoDarkenToggle_Changed" Unchecked="AutoDarkenToggle_Changed"
                                                  AutomationProperties.Name="{DynamicResource look_AutoDarken}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource look_AutoDarken}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{DynamicResource look_AutoDarken_Hint}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SKRÓTY ═══ -->
            <TabItem Header="{DynamicResource shell_Nav_Hotkeys}" Tag="Hotkeys" Style="{StaticResource RailTabItem}"
                     shell:NavRail.Icon="{StaticResource NavIconKeyboard}">
                <ScrollViewer Style="{StaticResource PageScroller}">
                    <StackPanel Style="{StaticResource PageContent}">
                        <TextBlock Style="{StaticResource PageHeading}" Text="{DynamicResource shell_Page_Hotkeys_Title}"/>
                        <TextBlock Style="{StaticResource PageLead}" Text="{DynamicResource Settings_Hotkeys_Hint}"/>

                        <Border x:Name="HotkeyConflictNotice" Visibility="Collapsed" Style="{StaticResource Callout}"
                                Background="{DynamicResource WarnLightBrush}" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="None" VerticalAlignment="Top"
                                      Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,1,10,0"/>
                                <TextBlock x:Name="HotkeyConflictNoticeText" Style="{StaticResource BodyText}" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" shell:Typo.Eyebrow="{DynamicResource shell_Hotkeys_Everyday}"/>
                                <StackPanel x:Name="HotkeysSkeleton">
                                    <Border Style="{StaticResource SkeletonBar}" Width="260" Margin="0,14,0,24"/>
                                    <Border Style="{StaticResource SkeletonBar}" Width="220" Margin="0,0,0,24"/>
                                    <Border Style="{StaticResource SkeletonBar}" Width="240" Margin="0,0,0,14"/>
                                </StackPanel>
                                <ListView x:Name="hotkeyListView" BorderThickness="0" Background="Transparent"
                                          ItemTemplate="{StaticResource HotkeyRowTemplate}" ItemContainerStyle="{StaticResource PlainListItem}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="{DynamicResource Hotkeys_Reset_Action}" x:Name="resetButton"
                                            Style="{StaticResource SecondaryButton}" MinWidth="120"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="HotkeysAdvancedExpander" Style="{StaticResource AdvancedExpander}" Header="{DynamicResource shell_Advanced}"
                                  Expanded="AdvancedExpander_Changed" Collapsed="AdvancedExpander_Changed">
                            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" shell:Typo.Eyebrow="{DynamicResource shell_Hotkeys_Rare}"/>
                                    <ListView x:Name="hotkeyListViewAdvanced" BorderThickness="0" Background="Transparent"
                                              ItemTemplate="{StaticResource HotkeyRowTemplate}" ItemContainerStyle="{StaticResource PlainListItem}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ POSTACIE (W8's page, full width) ═══ -->
            <TabItem Header="{DynamicResource shell_Nav_Characters}" Tag="Characters" Style="{StaticResource RailTabItem}"
                     shell:NavRail.Icon="{StaticResource NavIconPerson}">
                <views:CharactersPage x:Name="CharactersPage" Margin="20,16,20,12"/>
            </TabItem>

            <!-- ═══ POMOC: guides, contact, community, log, privacy, advanced mode ═══ -->
            <TabItem Header="{DynamicResource shell_Nav_Help}" Tag="Help" Style="{StaticResource RailTabItem}"
                     shell:NavRail.Icon="{StaticResource NavIconHelp}">
                <ScrollViewer x:Name="HelpPageScroller" Style="{StaticResource PageScroller}">
                    <StackPanel Style="{StaticResource PageContent}">
                        <TextBlock Style="{StaticResource PageHeading}" Text="{DynamicResource shell_Page_Help_Title}"/>
                        <TextBlock Style="{StaticResource PageLead}" Text="{DynamicResource shell_Page_Help_Lead}"/>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Help_Guides}" Margin="0,0,0,8"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource shell_Guide_Setup}" Click="GuideSetup_Click"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource shell_Guide_Region}" Click="GuideRegion_Click"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource shell_Guide_Borderless}" Click="GuideBorderless_Click"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource shell_Guide_Speed}" Click="GuideSpeed_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" MaxWidth="260" Margin="20,0,0,0">
                                    <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource shell_Help_Wizard_Body}" Margin="0,0,0,10"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource shell_Help_Wizard}"
                                            HorizontalAlignment="Left" Click="DashSetupGuide_Click"
                                            ToolTip="{DynamicResource Regions_SetupGuide_Tooltip}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Help_Trouble}"/>
                                <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource shell_Help_Trouble_Body}" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="ReportProblemButton" Content="{DynamicResource Logs_ReportProblem}"
                                            Style="{StaticResource ModernButton}" Click="ReportProblem_Click"
                                            ToolTip="{DynamicResource Tip_Logs_ReportProblem}" Margin="0,0,8,8"/>
                                    <Button x:Name="CommunitySendFeedbackButton" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource shell_Help_WriteToUs}" ToolTip="{DynamicResource Tip_Community_Feedback}"
                                            Click="DashSendFeedback_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="CommunityDiscordButton" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource Community_Discord_Button}" ToolTip="{DynamicResource Tip_Community_Discord}"
                                            Click="CommunityDiscord_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="CommunityXButton" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource Community_X_Button}" ToolTip="{DynamicResource Tip_Community_X}"
                                            Click="CommunityX_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="CommunityWebsiteButton" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource Community_Website_Button}" ToolTip="{DynamicResource Tip_Community_Web}"
                                            Click="CommunityWebsite_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Help_Community}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource Community_Referrals_Title}" FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{DynamicResource Community_Referrals_Body}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="CommunityReferralsButton" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource Community_Referrals_Button}" ToolTip="{DynamicResource Tip_Community_Referrals}"
                                            Click="DashReferrals_Click" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- The language vote. Names no language and promises no date: Polish is the only pack today. -->
                                <Grid x:Name="NextLanguageBanner" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{DynamicResource shell_Vote_Title}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{DynamicResource shell_Vote_Body}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="NextLanguageVoteButton" Style="{StaticResource SecondaryButton}"
                                            Content="{DynamicResource Translations_Vote_Button}" VerticalAlignment="Center"
                                            Click="NextLanguageVote_Click" ToolTip="{DynamicResource Translations_Vote_Tooltip}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- The log, complete: level filter, clear, open the files. -->
                        <Border x:Name="LogCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Help_Log}" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <ComboBox x:Name="LogLevelFilter" Width="150" Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="LogLevelFilter_SelectionChanged" Margin="0,0,8,8"
                                              AutomationProperties.Name="{DynamicResource Log_Level}">
                                        <ComboBoxItem Content="{DynamicResource Log_Filter_All}" IsSelected="True" Tag="ALL"/>
                                        <ComboBoxItem Content="{DynamicResource Logs_Severity_Debug}" Tag="DEBUG"/>
                                        <ComboBoxItem Content="{DynamicResource Logs_Severity_Info}" Tag="INFO"/>
                                        <ComboBoxItem Content="{DynamicResource Logs_Severity_Warn}" Tag="WARN"/>
                                        <ComboBoxItem Content="{DynamicResource Logs_Severity_Error}" Tag="ERROR"/>
                                    </ComboBox>
                                    <Button x:Name="ClearLogsButton" Content="{DynamicResource Btn_ClearLogs}" Style="{StaticResource SecondaryButton}"
                                            Click="ClearLogsButton_Click" ToolTip="{DynamicResource Tip_Logs_Clear}" Margin="0,0,8,8"/>
                                    <Button x:Name="OpenLogFileButton" Content="{DynamicResource Logs_OpenAppLog}" Style="{StaticResource SecondaryButton}"
                                            Click="OpenLogFileButton_Click" ToolTip="{DynamicResource Tip_Logs_OpenApp}" Margin="0,0,8,8"/>
                                    <Button Content="{DynamicResource Logs_OpenDialogueLog}" Style="{StaticResource SecondaryButton}"
                                            Click="OpenDialogueLogFolder_Click" ToolTip="{DynamicResource Tip_Logs_OpenDialogue}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <Border Height="360" CornerRadius="8" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                        Background="{DynamicResource BgBrush}" ClipToBounds="True">
                                    <Grid>
                                        <ListView x:Name="LogListView" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                                  BorderThickness="0" FontFamily="{StaticResource FontMono}" FontSize="{StaticResource FontSizeCaption}"
                                                  AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  VirtualizingStackPanel.IsVirtualizing="True">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="{DynamicResource Log_Time}" Width="92" DisplayMemberBinding="{Binding TimeString}"/>
                                                    <GridViewColumn Header="{DynamicResource Log_Level}" Width="62">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Level}" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DebugBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="INFO">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="{DynamicResource Log_Message}" Width="660" DisplayMemberBinding="{Binding Message}"/>
                                                </GridView>
                                            </ListView.View>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="Padding" Value="2,2"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                    <GridViewRowPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource LogAltRowBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                        <shell:StateMessage x:Name="LogsEmptyState" Visibility="Collapsed" Icon="{StaticResource NavIconList}"
                                                            Text="{DynamicResource state_Logs_Empty}" ActionText="{DynamicResource state_OpenAppLog}"
                                                            ActionClick="OpenLogFileButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings_Privacy_Card_Label}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="CrashReportingCheckBox" Style="{StaticResource ModernCheckBox}"
                                          Content="{DynamicResource CrashReporting_Setting_Label}" ToolTip="{DynamicResource Tip_Settings_CrashReports}"
                                          Checked="CrashReportingCheckBox_Changed" Unchecked="CrashReportingCheckBox_Changed"/>
                                <TextBlock Text="{DynamicResource CrashReporting_Setting_Description}" Style="{StaticResource HintText}" Margin="28,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AdvancedModeToggle" Style="{StaticResource ToggleSwitch}"
                                          Checked="AdvancedModeToggle_Changed" Unchecked="AdvancedModeToggle_Changed">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource shell_Help_AdvancedMode}" FontSize="{StaticResource FontSizeCardTitle}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="{DynamicResource shell_Help_AdvancedMode_Body}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="HelpAdvancedExpander" Style="{StaticResource AdvancedExpander}" Header="{DynamicResource shell_Advanced}"
                                  Expanded="AdvancedExpander_Changed" Collapsed="AdvancedExpander_Changed">
                            <StackPanel Margin="0,4,0,0">
                                <!-- Recognition model and the graphics card (the CPU fallback lives here too). -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings_OcrModel_Card_Label}"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Settings_OcrModel_Card_Body}" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Settings_OcrModel_Label}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="OcrModelComboBox" Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="320"
                                                      HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Settings_OcrModel_Label}"
                                                      ToolTip="{DynamicResource Tip_Settings_OcrModel}" SelectionChanged="OcrModelComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Settings_OcrModel_V6}" Tag="ppocr-v6-small"/>
                                                <ComboBoxItem Content="{DynamicResource Settings_OcrModel_V4}" Tag="ppocr-v4-mobile"/>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock x:Name="OcrModelDescription" Text="{DynamicResource Settings_OcrModel_V6_Description}"
                                                   Style="{StaticResource HintText}" Margin="170,8,0,0"/>
                                        <!-- Ticking it is "try my GPU again": it also clears the GPU quarantine. -->
                                        <CheckBox x:Name="UseGpuOcrCheckBox" Style="{StaticResource ModernCheckBox}"
                                                  Content="{DynamicResource Settings_OcrGpu_Checkbox}" ToolTip="{DynamicResource Tip_Settings_OcrGpu}"
                                                  Margin="170,12,0,0" Checked="UseGpuOcrCheckBox_Changed" Unchecked="UseGpuOcrCheckBox_Changed"/>
                                        <TextBlock x:Name="OcrGpuQuarantineHint" Text="{DynamicResource Settings_OcrGpu_Quarantined}"
                                                   Style="{StaticResource HintText}" Foreground="{DynamicResource WarnBrush}"
                                                   Margin="170,6,0,0" Visibility="Collapsed"/>
                                        <TextBlock x:Name="OcrModelRestartHint" Text="{DynamicResource Settings_OcrModel_Restart}"
                                                   Style="{StaticResource HintText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                                                   Margin="170,6,0,0" Visibility="Collapsed"/>
                                        <!-- Diagnostics: the graphics card with its driver ids and memory (Start shows its name only). -->
                                        <TextBlock x:Name="OcrGpuAdapterText" Style="{StaticResource HintText}" FontFamily="{StaticResource FontMono}"
                                                   Margin="170,10,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource shell_Help_Log}" Margin="0,0,0,12"/>
                                        <CheckBox x:Name="DetailedLoggingCheckBox" Style="{StaticResource ModernCheckBox}"
                                                  Content="{DynamicResource Logs_DetailedLogging}" ToolTip="{DynamicResource Tip_Logs_DetailedLogging}"
                                                  Checked="DetailedLogging_Changed" Unchecked="DetailedLogging_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════
             STATUS BAR: the single source of status. Version far left,
             then translation state, reader (GPU/CPU), dictionary; links right.
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0" MinHeight="44">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="VersionChip" Style="{StaticResource BarChipButton}" Content="v2.5.1" Click="VersionChip_Click"
                            ToolTip="{DynamicResource shell_Bar_Version_Tip}" AutomationProperties.Name="{DynamicResource shell_Bar_Version_Tip}"/>
                    <Border x:Name="StateChip" Style="{StaticResource Chip}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateChipDot" Style="{StaticResource StatusDot}"/>
                            <TextBlock x:Name="DashOcrDetailStatus" Style="{StaticResource ChipText}"
                                       Text="{DynamicResource shell_Status_Stopped}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="EngineChip" Style="{StaticResource Chip}" Margin="8,0,0,0">
                        <TextBlock x:Name="DashEngineStatus" Style="{StaticResource ChipText}" Text="{DynamicResource shell_Chip_ReaderStarting}"/>
                    </Border>
                    <Border x:Name="DictChip" Style="{StaticResource Chip}" Margin="8,0,0,0">
                        <TextBlock x:Name="DashDictStatus" Style="{StaticResource ChipText}" Text="{DynamicResource shell_Chip_DictLoading}"/>
                    </Border>
                </StackPanel>
                <!-- Right: Discord, then "Więcej" (Informacje, Zgłoś problem, kaption.one, Język). The setup guide, X and the
                     same links stay on Pomoc. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BarDiscordButton" Style="{StaticResource BarIconButton}" Tag="{DynamicResource shell_Bar_Discord}" Click="CommunityDiscord_Click"
                            ToolTip="{DynamicResource shell_Bar_Discord}" AutomationProperties.Name="{DynamicResource shell_Bar_Discord}">
                        <Path Data="{StaticResource BrandDiscord}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="BarMoreButton" Style="{StaticResource BarTextButton}" Click="BarMore_Click"
                            AutomationProperties.Name="{DynamicResource bar_More}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource bar_More}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconChevronDown}" Width="16" Height="16" Stretch="None" StrokeThickness="1.6" Margin="4,1,0,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </Path.RenderTransform>
                            </Path>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="BarMoreMenu" Style="{StaticResource BarMenu}">
                                <MenuItem x:Name="BarMoreAbout" Style="{StaticResource BarMenuItem}" Header="{DynamicResource bar_More_About}" Click="BarAbout_Click">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource NavIconInfo}" Width="20" Height="20" Stretch="None" StrokeThickness="1.6"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="BarMoreReport" Style="{StaticResource BarMenuItem}" Header="{DynamicResource bar_More_Report}" Click="ReportProblem_Click">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource NavIconChat}" Width="20" Height="20" Stretch="None" StrokeThickness="1.6"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="BarMoreWeb" Style="{StaticResource BarMenuItem}" Header="{DynamicResource bar_More_Web}" Click="CommunityWebsite_Click">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource IconExternal}" Width="16" Height="16" Stretch="None" StrokeThickness="1.6" Margin="2,0,0,0"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource BarMenuSeparator}"/>
                                <MenuItem Style="{StaticResource BarMenuCaption}" Header="{DynamicResource bar_More_Language}"/>
                                <MenuItem x:Name="BarLangPl" Style="{StaticResource BarMenuItem}" Header="Polski" Tag="pl-PL" Click="BarLanguage_Click"/>
                                <MenuItem x:Name="BarLangEn" Style="{StaticResource BarMenuItem}" Header="English" Tag="en-US" Click="BarLanguage_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hidden: kept for code compat -->
        <TextBlock x:Name="DashPredictionStatus" Visibility="Collapsed"/>
    </Grid>
</Window>
