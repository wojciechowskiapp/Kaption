<Window x:Class="GI_Subtitles.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GI_Subtitles.Views"
        xmlns:rendering="clr-namespace:GI_Subtitles.Services.Rendering"
        mc:Ignorable="d"
        WindowStyle="None" Height="20" ShowInTaskbar="False" Topmost="True" Background="Transparent" AllowsTransparency="True" PreviewMouseLeftButtonDown="Window_MouseDown">
    <Grid Background="Transparent">
        <!-- The subtitle panel: speaker tag, the line (two balanced lines at most), answers. The same control draws the
             preview on Wygląd napisów; its parts keep their names (HeaderText, SubtitleText, AnswerSeparator, AnswerText)
             for the code that finds them by name. Look and size come from OverlayStyle at runtime. -->
        <rendering:SubtitleCard x:Name="SubtitleBackground"/>
    </Grid>
</Window>
