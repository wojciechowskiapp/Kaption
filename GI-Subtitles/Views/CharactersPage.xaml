<UserControl x:Class="GI_Subtitles.Views.CharactersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GI_Subtitles.Views"
             xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell"
             IsVisibleChanged="Page_IsVisibleChanged" PreviewKeyDown="Page_PreviewKeyDown">
    <!-- The Characters tab: a searchable, filterable list of the current game's characters next to the
         selected character's page. Loading, empty and error states are part of the page. -->
    <!-- Control styles (ModernTextBox, buttons, text styles) come from the host, which merges ModernStyles.xaml, so
         they are DynamicResource here; the colours follow the app palette (see SyncPaletteWithApp). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/CharacterPaletteLight.xaml"/>
                <ResourceDictionary Source="../Resources/CharacterLayoutPage.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:IconImageConverter x:Key="CharIconImage"/>
            <local:MissingIconConverter x:Key="CharMissingIcon"/>
            <local:EmptyToCollapsedConverter x:Key="CharEmptyCollapsed"/>

            <!-- Selected: a wash of the character's element and a bar in its colour. -->
            <Style x:Key="CharListItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,6,10,6"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,9"
                                        Background="{Binding ElementFill}" Visibility="Hidden"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Hover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{Binding ElementWash}"/>
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Element filter: one swatch per element; the tooltip names it. -->
            <Style x:Key="CharFilterItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,2,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="ToolTip" Value="{Binding Label}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent"
                                    Background="Transparent" Padding="2">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Char_RingStrong}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Char_Fg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CharRarity" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Char_FgSubtle}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RarityTier}" Value="top">
                        <Setter Property="Foreground" Value="{DynamicResource Char_Rarity5}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RarityTier}" Value="high">
                        <Setter Property="Foreground" Value="{DynamicResource Char_Rarity4}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Skeleton" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Char_Skeleton}"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

            <!-- A soft pulse while something loads; the only motion here, and only while waiting. -->
            <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <DataTemplate x:Key="SkeletonRow">
                <Grid Margin="8,8,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="34" Height="34" Fill="{DynamicResource Char_Skeleton}"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Style="{StaticResource Skeleton}" Height="10" Width="{Binding}" HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource Skeleton}" Height="8" Width="48" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Browser">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── List column ── -->
            <DockPanel Margin="0,0,16,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" Style="{DynamicResource ModernTextBox}" Padding="30,5,30,5"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             AutomationProperties.Name="{DynamicResource Char_Search_Label}"/>
                    <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Stretch="None" Margin="10,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                          Stroke="{DynamicResource Char_FgSubtle}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource Char_Search_Label}" FontSize="13" Margin="31,0,0,0"
                               Foreground="{DynamicResource Char_FgSubtle}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button x:Name="SearchClear" Style="{DynamicResource IconButton}" Width="26" Height="26" Margin="0,0,4,0"
                            HorizontalAlignment="Right" Visibility="Collapsed" Click="SearchClear_Click"
                            ToolTip="{DynamicResource Char_Search_Clear}" AutomationProperties.Name="{DynamicResource Char_Search_Clear}">
                        <Path Data="{StaticResource IconClose}" Width="16" Height="16" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>

                <DockPanel DockPanel.Dock="Top" Margin="-2,0,0,6">
                    <Button x:Name="FilterClear" DockPanel.Dock="Right" Visibility="Collapsed" Style="{DynamicResource IconButton}"
                            Width="26" Height="26" VerticalAlignment="Top" Click="FilterClear_Click"
                            ToolTip="{DynamicResource Char_Filter_Clear}" AutomationProperties.Name="{DynamicResource Char_Filter_Clear}">
                        <Path Data="{StaticResource IconClose}" Width="16" Height="16" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <ListBox x:Name="ElementFilter" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource CharFilterItem}"
                             SelectionChanged="ElementFilter_SelectionChanged"
                             PreviewMouseLeftButtonDown="ElementFilter_PreviewMouseLeftButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyboardNavigation.DirectionalNavigation="Cycle">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="18" Height="18" Fill="{Binding Fill}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Style="{DynamicResource CaptionText}" Margin="2,0,0,6"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Char_Page_Hint}" Style="{DynamicResource CaptionText}"
                           Margin="2,10,0,0"/>

                <Grid>
                    <ListBox x:Name="CharacterList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource CharListItem}"
                             SelectionChanged="CharacterList_SelectionChanged" PreviewKeyDown="CharacterList_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="2,2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                             AutomationProperties.Name="{DynamicResource Tab_Characters}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34">
                                        <Ellipse Fill="{Binding ElementSoft}"/>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource CharIconImage}, ConverterParameter=34}"
                                                            Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Grid Visibility="{Binding IconPath, Converter={StaticResource CharMissingIcon}, ConverterParameter=34}">
                                            <Ellipse Fill="{Binding ElementFill}"/>
                                            <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource FontDisplay}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{Binding ElementInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Char_Fg}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Gloss}" FontSize="11" Foreground="{DynamicResource Char_FgSubtle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Gloss, Converter={StaticResource CharEmptyCollapsed}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Rarity}" Style="{StaticResource CharRarity}"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Nothing matches the search or the filter: one sentence, one action (the shared state component). -->
                    <shell:StateMessage x:Name="NoResults" Visibility="Collapsed" Margin="8,24,8,0" VerticalAlignment="Top"
                                        Icon="{StaticResource IconSearch}" Text="{DynamicResource state_Char_NoResults}"
                                        ActionText="{DynamicResource Char_Search_Clear}" ActionClick="ClearAll_Click"/>

                    <ItemsControl x:Name="ListSkeleton" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"
                                  ItemTemplate="{StaticResource SkeletonRow}"/>
                </Grid>
            </DockPanel>

            <!-- ── Detail ── -->
            <Border Grid.Column="1" Background="{DynamicResource Char_Surface}" BorderBrush="{DynamicResource Char_Ring}"
                    BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
                <Grid local:RoundedClip.Radius="9">
                    <!-- The character page scrolls itself (its section tabs stay pinned). -->
                    <ContentControl x:Name="OverviewHost" Focusable="False"/>

                    <!-- Placeholder with the page's own shapes while the first character builds. -->
                    <StackPanel x:Name="DetailSkeleton" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border Height="200" BorderBrush="{DynamicResource Char_Ring}" BorderThickness="0,0,0,1">
                            <Grid Margin="24,0,24,0">
                                <StackPanel VerticalAlignment="Center">
                                    <Border Style="{StaticResource Skeleton}" Height="22" Width="200" HorizontalAlignment="Left"/>
                                    <Border Style="{StaticResource Skeleton}" Height="14" Width="150" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                                </StackPanel>
                                <Border Style="{StaticResource Skeleton}" Width="160" Height="160" CornerRadius="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="24,22,24,0">
                            <Border Style="{StaticResource Skeleton}" Height="14" Width="140" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource Skeleton}" Height="64" Margin="0,14,0,0" CornerRadius="10"/>
                            <Border Style="{StaticResource Skeleton}" Height="14" Width="110" Margin="0,26,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource Skeleton}" Height="40" Margin="0,14,0,0" CornerRadius="10"/>
                            <Border Style="{StaticResource Skeleton}" Height="40" Margin="0,10,0,0" CornerRadius="10"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Char_Loading}" Style="{DynamicResource CaptionText}" Margin="24,18,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Whole-page states: the shared state component, one sentence and one action each ── -->
        <shell:StateMessage x:Name="EmptyState" Visibility="Collapsed" Icon="{StaticResource IconPeople}"
                            Text="{DynamicResource state_Char_Empty}" ActionText="{DynamicResource state_CheckAgain}" ActionClick="Retry_Click"/>

        <shell:StateMessage x:Name="ErrorState" Visibility="Collapsed" Tone="Problem" Icon="{StaticResource IconWarning}"
                            Text="{DynamicResource state_Char_Error}" ActionText="{DynamicResource Char_Error_Retry}" ActionClick="Retry_Click"/>
    </Grid>
</UserControl>
