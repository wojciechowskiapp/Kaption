<UserControl x:Class="GI_Subtitles.Views.FarmTodayBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GI_Subtitles.Views">
    <!-- Settings › Characters (Genshin): today's books at a glance, "Show the card", and behind "Settings" the UID with
         its consent line, the server, the startup switch and "Remove UID and data". Colours from the page's Char_*
         palette; control styles (ModernTextBox, buttons, combo, check box) from the host. -->
    <UserControl.Resources>
        <local:IconImageConverter x:Key="FbIconImage"/>
        <local:MissingIconConverter x:Key="FbMissingIcon"/>
        <Geometry x:Key="FbBookGlyph">M3,3.5 C5,2.6 6.8,2.8 8,3.8 C9.2,2.8 11,2.6 13,3.5 V12.6 C11,11.8 9.2,12 8,13 C6.8,12 5,11.8 3,12.6 Z M8,3.8 V13</Geometry>
        <Geometry x:Key="FbChevron">M4.5,6 L8,9.5 L11.5,6</Geometry>
        <Style x:Key="FbToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource Char_Ring}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Hover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Char_RingStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Selected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FbTile">
            <Grid Width="34" Height="34" Margin="0,0,6,0" ToolTip="{Binding Tooltip}">
                <Border CornerRadius="8" Background="{Binding Frame}"/>
                <Path Data="{StaticResource FbBookGlyph}" Width="17" Height="17" Stretch="Uniform" Stroke="White" StrokeThickness="1.3"
                      Visibility="{Binding IconPath, Converter={StaticResource FbMissingIcon}, ConverterParameter=30}"/>
                <Image Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding IconPath, Converter={StaticResource FbIconImage}, ConverterParameter=30}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Char_CardBg}" BorderBrush="{DynamicResource Char_Ring}" BorderThickness="1"
            CornerRadius="12" Padding="16,12,12,12" SnapsToDevicePixels="True">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Char_Fg}">
                        <Run Text="{DynamicResource FarmCard_Eyebrow}"/><Run x:Name="DayRun" Foreground="{DynamicResource Char_FgSubtle}" FontWeight="Normal"/>
                    </TextBlock>
                    <TextBlock x:Name="Lead" Text="{DynamicResource FarmBlock_Lead}" Margin="0,2,0,0" FontSize="12"
                               Foreground="{DynamicResource Char_FgMuted}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left"/>
                </StackPanel>
                <ItemsControl x:Name="Tiles" Grid.Column="1" ItemTemplate="{StaticResource FbTile}" VerticalAlignment="Center"
                              HorizontalAlignment="Left" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShowButton" Style="{DynamicResource ModernButton}" Content="{DynamicResource FarmBlock_Show}"
                            Padding="14,0" Height="32" Click="ShowButton_Click"/>
                    <ToggleButton x:Name="SettingsToggle" Margin="8,0,0,0" Height="32" Padding="10,0" Cursor="Hand"
                                  Click="SettingsToggle_Click" Style="{DynamicResource FbToggle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource FarmBlock_Settings}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Char_Fg}"/>
                            <Path x:Name="Chevron" Data="{StaticResource FbChevron}" Width="16" Height="16" Stretch="None" Margin="4,0,0,0"
                                  Stroke="{DynamicResource Char_FgMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Height="1" Background="{DynamicResource Char_Divider}" Margin="0,0,0,12"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{DynamicResource FarmBlock_Uid_Label}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Char_FgMuted}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="UidBox" Width="170" Style="{DynamicResource ModernTextBox}" MaxLength="10"
                                     AutomationProperties.Name="{DynamicResource FarmBlock_Uid_Label}" KeyDown="UidBox_KeyDown"/>
                            <Button x:Name="SaveButton" Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" Height="32" Padding="14,0"
                                    Content="{DynamicResource FarmBlock_Save}" Click="SaveButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="UidNote" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource Char_Accent}"/>
                        <TextBlock Text="{DynamicResource FarmBlock_Uid_Consent}" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Char_FgSubtle}" MaxWidth="420" HorizontalAlignment="Left"/>
                        <Button x:Name="ForgetButton" Margin="0,8,0,0" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left"
                                Height="28" Padding="10,0" Content="{DynamicResource FarmBlock_Forget}" Click="ForgetButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" MinWidth="200">
                        <TextBlock Text="{DynamicResource FarmBlock_Region}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Char_FgMuted}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RegionBox" Style="{DynamicResource ModernComboBox}" Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="RegionBox_SelectionChanged">
                            <ComboBoxItem Tag="europe" Content="{DynamicResource FarmBlock_Region_Europe}"/>
                            <ComboBoxItem Tag="america" Content="{DynamicResource FarmBlock_Region_America}"/>
                            <ComboBoxItem Tag="asia" Content="{DynamicResource FarmBlock_Region_Asia}"/>
                        </ComboBox>
                        <CheckBox x:Name="EnabledBox" Margin="0,12,0,0" Style="{DynamicResource ModernCheckBox}"
                                  Content="{DynamicResource FarmBlock_Enabled}" Click="EnabledBox_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
