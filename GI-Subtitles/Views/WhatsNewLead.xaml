<UserControl x:Class="GI_Subtitles.Views.WhatsNewLead"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- Start › "New in Kaption" (WhatsNewLead.xaml.cs, Services/Notices/WhatsNew): the two or three things a release
         brings this player, each in a sentence or two, a question where the thing is the player's to switch on. It
         leads the once-cards and wears their brand edge. Opened from Help it is the whole list, a switch per row.
         Every colour, size and style is a palette or token key, DynamicResource: the host supplies them (the
         Settings window, or a render test). -->
    <UserControl.Resources>
        <!-- 16-unit glyphs, one stroke weight, drawn like the tokens' own icons. -->
        <Geometry x:Key="WnHourglass">M4.5,2.5 H11.5 M4.5,13.5 H11.5 M5.5,2.5 V4.6 L8,8 L10.5,4.6 V2.5 M5.5,13.5 V11.4 L8,8 L10.5,11.4 V13.5</Geometry>
        <Geometry x:Key="WnCalendar">M3,4.5 H13 V13 H3 Z M3,7.2 H13 M5.8,2.8 V5.6 M10.2,2.8 V5.6</Geometry>
        <Geometry x:Key="WnPower">M8,2.5 V8 M4.8,4.7 A4.6,4.6 0 1 0 11.2,4.7</Geometry>
        <Geometry x:Key="WnRecord">M13.5,8 A5.5,5.5 0 1 1 2.5,8 A5.5,5.5 0 1 1 13.5,8 Z M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8 Z</Geometry>
        <Geometry x:Key="WnSpark">M8,2.5 V5.5 M8,10.5 V13.5 M2.5,8 H5.5 M10.5,8 H13.5 M4.3,4.3 L5.9,5.9 M10.1,10.1 L11.7,11.7 M11.7,4.3 L10.1,5.9 M5.9,10.1 L4.3,11.7</Geometry>
        <Geometry x:Key="WnCheck">M3.5,8.5 L6.5,11.5 L12.5,4.5</Geometry>
    </UserControl.Resources>

    <Border x:Name="Frame" Style="{DynamicResource Card}" Margin="0,16,0,0" Padding="0" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0,14" CornerRadius="0,2,2,0" Background="{DynamicResource BrandGradientBrush}"/>
            <StackPanel Grid.Column="1" Margin="18,12,12,14">
                <!-- The card's own heading, not a label over one: the rows below are its content. -->
                <TextBlock x:Name="Heading" Style="{DynamicResource CardTitle}" Margin="0,2,0,0" AutomationProperties.HeadingLevel="Level2"/>

                <ItemsControl x:Name="Rows" Focusable="False" Margin="0,12,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="40,14,0,14" Visibility="{Binding RuleVisibility}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Top">
                                        <Path Data="{Binding Icon}" Width="16" Height="16" Stretch="None" StrokeThickness="1.4"
                                              Stroke="{DynamicResource AccentTextBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding Body}" Style="{DynamicResource HintText}" MaxWidth="560" HorizontalAlignment="Left"/>

                                        <!-- A question, asked once: yes, later, never. -->
                                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding AskVisibility}">
                                            <Button Style="{DynamicResource ModernButton}" Content="{DynamicResource WhatsNew_TurnOn}" Margin="0,0,8,4"
                                                    Click="TurnOn_Click" AutomationProperties.Name="{Binding TurnOnName}"/>
                                            <Button Style="{DynamicResource SecondaryButton}" Content="{DynamicResource WhatsNew_NotNow}" Margin="0,0,8,4"
                                                    Click="NotNow_Click" AutomationProperties.Name="{Binding NotNowName}"/>
                                            <Button Style="{DynamicResource GhostButton}" Content="{DynamicResource WhatsNew_Never}"
                                                    Margin="0,0,0,4" Click="Never_Click" AutomationProperties.Name="{Binding NeverName}"/>
                                        </WrapPanel>

                                        <!-- Turned on from the card: the row says what happens next. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding DoneVisibility}">
                                            <Path Data="{StaticResource WnCheck}" Width="16" Height="16" Stretch="None" StrokeThickness="1.8"
                                                  Stroke="{DynamicResource SuccessBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                            <TextBlock Text="{Binding Done}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" MaxWidth="530" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>

                                        <Button Style="{DynamicResource LinkButton}" Content="{Binding ActionLabel}" HorizontalAlignment="Left"
                                                Margin="0,6,0,0" Click="Action_Click" Visibility="{Binding ActionVisibility}"/>
                                    </StackPanel>
                                    <!-- The list the player opened: the thing's own switch, live. -->
                                    <CheckBox Grid.Column="2" Style="{DynamicResource ToggleSwitch}" VerticalAlignment="Top" Margin="0,4,0,0"
                                              IsChecked="{Binding SwitchOn, Mode=OneWay}" Visibility="{Binding SwitchVisibility}"
                                              Checked="Switch_Changed" Unchecked="Switch_Changed"
                                              AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Body}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,14,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterHint" Text="{DynamicResource WhatsNew_Footer}" FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="40,0,12,0"/>
                    <Button x:Name="DoneButton" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Click="Close_Click" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
