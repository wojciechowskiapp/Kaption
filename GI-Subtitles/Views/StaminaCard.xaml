<UserControl x:Class="GI_Subtitles.Views.StaminaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- Start › the selected game's stamina timer (StaminaCard.xaml.cs, Services/Stamina). The switch is the player's
         consent to read the number off the game screen, off until they flip it, and the sentence beside it says what
         is read. With a reading: the value by the timer, when it fills, how fresh the read is, the site's timer.
         Every colour and size is a palette or token key, DynamicResource, because the host supplies them (the
         Settings window, or a render test). The same chrome as the codes card below it. -->
    <UserControl.Resources>
        <Geometry x:Key="StHourglass">M4.5,2.5 H11.5 M4.5,13.5 H11.5 M5.5,2.5 V4.6 L8,8 L10.5,4.6 V2.5 M5.5,13.5 V11.4 L8,8 L10.5,11.4 V13.5</Geometry>
    </UserControl.Resources>

    <Border x:Name="Frame" Style="{DynamicResource Card}" Padding="16,10,16,12" Margin="0,16,0,0">
        <StackPanel>
            <Grid MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center">
                    <Path Data="{StaticResource StHourglass}" Width="16" Height="16" Stretch="None" StrokeThickness="1.4"
                          Stroke="{DynamicResource AccentTextBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run x:Name="TitleRun" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><Run
                         x:Name="NumberRun" FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </TextBlock>
                <CheckBox x:Name="ReadToggle" Grid.Column="2" Style="{DynamicResource ToggleSwitch}" VerticalAlignment="Center"
                          Checked="ReadToggle_Changed" Unchecked="ReadToggle_Changed"/>
            </Grid>

            <StackPanel Margin="40,2,0,0">
                <TextBlock x:Name="LineText" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel x:Name="FreshRow" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="FreshText" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="TimerButton" Style="{DynamicResource LinkButton}" VerticalAlignment="Center"
                            Content="{DynamicResource Stamina_OpenTimer}" ToolTip="{DynamicResource Stamina_OpenTimer_Tip}" Click="Timer_Click"/>
                </StackPanel>
                <CheckBox x:Name="NoticeToggle" Style="{DynamicResource ModernCheckBox}" Margin="0,10,0,0" Visibility="Collapsed"
                          HorizontalAlignment="Left" Checked="NoticeToggle_Changed" Unchecked="NoticeToggle_Changed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Stamina_Notice_Toggle}" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="NoticeHint" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,1,0,0" Padding="0,0,0,3"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
