<UserControl x:Class="GI_Subtitles.Views.TodayBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- Start › today in the selected game (TodayBlock.xaml.cs, Services/Today): the Today card's model as a compact
         block, for a player who never sees the card over the game. This week's resets, what ends soon, what was seen
         on this PC, Genshin's books; the stamina timer has its own card above. Every colour and size is a palette or
         token key, DynamicResource, because the host supplies them (the Settings window, or a render test). The same
         chrome as the stamina and codes cards beside it. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="TbBoolVis"/>
        <Geometry x:Key="TbCalendar">M3,4.5 H13 V13 H3 Z M3,7 H13 M5.5,2.8 V5.2 M10.5,2.8 V5.2</Geometry>

        <!-- One line: the text, a note on the right ("in 5 h"), a small line under it. A link line opens its article. -->
        <DataTemplate x:Key="TbLine">
            <Grid Margin="0,0,0,0" MinHeight="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Plain" Text="{Binding Text}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Visibility="{Binding HasText, Converter={StaticResource TbBoolVis}}"/>
                <Button x:Name="Link" Style="{DynamicResource LinkButton}" Content="{Binding Text}" ToolTip="{Binding Text}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Click="Link_Click" Visibility="Collapsed"/>
                <TextBlock Grid.Column="1" Text="{Binding Note}" Margin="12,0,0,0" FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Visibility="{Binding HasNote, Converter={StaticResource TbBoolVis}}"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Sub}" Margin="0,1,0,0" FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                           Visibility="{Binding HasSub, Converter={StaticResource TbBoolVis}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLink}" Value="True"/>
                        <Condition Binding="{Binding HasText}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Plain" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Link" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TbSection">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,2"/>
                <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource TbLine}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="Frame" Style="{DynamicResource Card}" Padding="16,10,16,12" Margin="0,16,0,0">
        <StackPanel>
            <Grid MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center">
                    <Path Data="{StaticResource TbCalendar}" Width="16" Height="16" Stretch="None" StrokeThickness="1.4"
                          Stroke="{DynamicResource AccentTextBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run x:Name="TitleRun" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><Run
                         x:Name="DayRun" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </TextBlock>
                <Button x:Name="ShowButton" Grid.Column="2" Style="{DynamicResource LinkButton}" VerticalAlignment="Center"
                        Content="{DynamicResource TodayBlock_Show}" ToolTip="{DynamicResource TodayBlock_Show_Tip}" Click="Show_Click"/>
            </Grid>
            <ItemsControl x:Name="SectionList" Margin="40,0,0,0" MaxWidth="640" HorizontalAlignment="Left" ItemTemplate="{StaticResource TbSection}"
                          Focusable="False"/>
            <!-- The reset times are the server's: the choice sits with them (one choice for every game). -->
            <StackPanel x:Name="ServerRow" Orientation="Horizontal" Margin="40,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ServerLabel" Text="{DynamicResource TodayBlock_Server}" FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="ServerBox" Style="{DynamicResource ModernComboBox}" Width="170" VerticalAlignment="Center"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ServerBox_SelectionChanged"
                          AutomationProperties.LabeledBy="{Binding ElementName=ServerLabel}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
