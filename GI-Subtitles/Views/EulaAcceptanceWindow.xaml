<Window x:Class="GI_Subtitles.Views.EulaAcceptanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell"
        Title="{DynamicResource Eula_WindowTitle}"
        Height="580" Width="560"
        Icon="../Resources/kaption.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Style="{DynamicResource KaptionWindow}"
        Closing="Window_Closing">

    <!-- Legal acceptance for returning users when CurrentEulaVersion is bumped (new installs accept it in the
         setup window). Accept = EulaAcceptedVersion + time; Decline quits with code 2. Crash reports stay opt-in. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shell:TitleBar Title="{DynamicResource Eula_WindowTitle}" CanMaximize="False"/>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Border Background="{StaticResource BandBgBrush}"/>
            <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.6" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name=""/>
            <Border Background="{StaticResource BackdropScrimBrush}"/>

            <Border Style="{StaticResource DialogCard}" VerticalAlignment="Center" Margin="28,20" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <StackPanel Margin="28,26,28,8">
                            <Image Source="{StaticResource KaptionMark}" Width="36" Height="36" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Text="{DynamicResource Eula_Heading}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{DynamicResource Eula_Intro}" Style="{StaticResource BodyText}" Margin="0,8,0,12"/>
                            <WrapPanel Margin="0,0,0,16">
                                <TextBlock Margin="0,0,14,0">
                                    <Hyperlink x:Name="LinkEula" NavigateUri="https://kaption.one/legal/eula" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run x:Name="RunLinkEula" Text="EULA"/>
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,0,14,0">
                                    <Hyperlink x:Name="LinkPrivacy" NavigateUri="https://kaption.one/legal/privacy" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run x:Name="RunLinkPrivacy" Text="Privacy Policy"/>
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,0,14,0">
                                    <Hyperlink x:Name="LinkDiscord" NavigateUri="https://discord.gg/zUAbXEZktw" RequestNavigate="Hyperlink_RequestNavigate">Discord</Hyperlink>
                                </TextBlock>
                                <TextBlock>
                                    <Hyperlink x:Name="LinkTwitter" NavigateUri="https://x.com/KaptionOne" RequestNavigate="Hyperlink_RequestNavigate">X</Hyperlink>
                                </TextBlock>
                            </WrapPanel>

                            <!-- Crash reports: opt-in, off by default. -->
                            <Border Style="{StaticResource Callout}" Padding="14,12">
                                <StackPanel>
                                    <CheckBox x:Name="CbCrashReports" Style="{StaticResource ModernCheckBox}">
                                        <TextBlock TextWrapping="Wrap" Text="{DynamicResource Eula_CrashOptIn}" Foreground="{DynamicResource TextBrush}"/>
                                    </CheckBox>
                                    <TextBlock Text="{DynamicResource Eula_CrashOptInHint}" Style="{StaticResource HintText}" Margin="28,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Clicking Accept is the consent; this line says so. -->
                            <TextBlock Style="{StaticResource HintText}" Margin="0,14,0,0">
                                <Run x:Name="RunLegalPrefix"/><Run x:Name="RunLegalAction" FontWeight="SemiBold"/><Run x:Name="RunLegalSuffix"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnQuit" Style="{StaticResource GhostButton}" Content="{DynamicResource Eula_Decline}"
                                    HorizontalAlignment="Left" Click="Quit_Click"/>
                            <Button x:Name="BtnContinue" Grid.Column="1" Style="{StaticResource ModernButton}" Margin="0"
                                    Content="{DynamicResource Eula_Continue}" MinWidth="160" IsDefault="True" Click="Continue_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
