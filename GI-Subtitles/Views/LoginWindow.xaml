<Window x:Class="GI_Subtitles.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell"
        Title="{DynamicResource Login_WindowTitle}"
        Height="560" Width="480"
        Icon="../Resources/kaption.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Style="{DynamicResource KaptionWindow}"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                 Storyboard.TargetProperty="Angle"
                                 From="0" To="360" Duration="0:0:1.2"/>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shell:TitleBar Title="{DynamicResource Login_WindowTitle}" CanMaximize="False"/>

        <!-- One soft ambience image under an ink scrim; the card carries all the text. -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Border Background="{StaticResource BandBgBrush}"/>
            <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.6" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name=""/>
            <Border Background="{StaticResource BackdropScrimBrush}"/>

            <Border Style="{StaticResource DialogCard}" VerticalAlignment="Center" Margin="28,0">
                <Grid>
                    <!-- Ready to sign in -->
                    <StackPanel x:Name="InitialPanel">
                        <Image Source="{StaticResource KaptionMark}" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="{DynamicResource Login_Heading}" Style="{StaticResource PageHeading}"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Login_Subheading}" Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,22"/>
                        <Button x:Name="BtnSignIn" Style="{StaticResource PrimaryHeroButton}" HorizontalAlignment="Stretch"
                                Content="{DynamicResource Login_SignInButton}" Click="SignIn_Click"/>
                        <TextBlock Text="{DynamicResource Login_SignInHint}" Style="{StaticResource HintText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"/>
                        <Button x:Name="BtnQuit" Style="{StaticResource GhostButton}" Content="{DynamicResource Login_QuitButton}"
                                HorizontalAlignment="Center" Margin="0,14,0,0" Click="Quit_Click"/>
                    </StackPanel>

                    <!-- Waiting for the browser -->
                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed">
                        <Grid Width="52" Height="52" HorizontalAlignment="Center" Margin="0,4,0,18">
                            <Ellipse Stroke="{DynamicResource SkeletonBrush}" StrokeThickness="5"/>
                            <Ellipse x:Name="SpinnerArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                                     StrokeDashArray="1,4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{DynamicResource Login_Waiting}" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{DynamicResource Login_WaitingHint}" Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,22"/>
                        <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Common_Cancel}"
                                HorizontalAlignment="Center" Click="Cancel_Click"/>
                    </StackPanel>

                    <!-- Error, with retry -->
                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource ErrorLightBrush}" CornerRadius="26" Width="52" Height="52"
                                HorizontalAlignment="Center" Margin="0,4,0,16">
                            <Path Data="{StaticResource IconClose}" Width="16" Height="16" Stretch="None" StrokeThickness="1.6"
                                  Stroke="{DynamicResource ErrorBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="ErrorTitle" Text="{DynamicResource Login_Error_Title_Generic}" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" TextAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
                        <TextBlock x:Name="ErrorMessage" Text="" Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnRetry" Style="{StaticResource ModernButton}" Content="{DynamicResource Common_TryAgain}"
                                    MinWidth="132" Click="SignIn_Click"/>
                            <Button x:Name="BtnQuitError" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Common_Quit}"
                                    Click="Quit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
