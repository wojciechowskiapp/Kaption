<Window x:Class="GI_Subtitles.Views.FileProtectionBootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell"
        Title="Kaption"
        Height="260" Width="440"
        Icon="../Resources/kaption.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{DynamicResource KaptionWindow}"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                 Storyboard.TargetProperty="Angle"
                                 From="0" To="360" Duration="0:0:1.2"/>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- No close button: the key must land (or the user quits from the error state). -->
        <shell:TitleBar Title="Kaption" CanMinimize="False" CanMaximize="False" CanClose="False"/>

        <Grid Grid.Row="1" Margin="32,20,32,24">
            <!-- Working (default) -->
            <StackPanel x:Name="WorkingPanel" VerticalAlignment="Center">
                <Grid HorizontalAlignment="Center" Margin="0,0,0,16" Width="32" Height="32">
                    <Ellipse Stroke="{DynamicResource SkeletonBrush}" StrokeThickness="3"/>
                    <Path x:Name="Spinner" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 16 1 A 15 15 0 0 1 31 16" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock Text="{DynamicResource shell_Protect_Working_Title}" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="WorkingDetail" Text="{DynamicResource shell_Protect_Working_Detail}" Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Error after the retries -->
            <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource shell_Protect_Error_Title}" Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" TextAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock x:Name="ErrorDetail" Text="{DynamicResource shell_Protect_Err_Generic}" Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnRetry" Content="{DynamicResource Common_TryAgain}" Style="{StaticResource ModernButton}"
                            MinWidth="132" Click="Retry_Click"/>
                    <Button x:Name="BtnQuit" Content="{DynamicResource Common_Quit}" Style="{StaticResource SecondaryButton}"
                            MinWidth="100" Click="Quit_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
