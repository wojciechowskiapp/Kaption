    <sys:String x:Key="Settings_OcrModel_Card_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Text recognition model</sys:String>
    <sys:String x:Key="Settings_OcrModel_Card_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Choose how Kaption reads dialogue from the game. The recommended model gives better screen-text accuracy; the compatibility model is a lighter engine.</sys:String>
    <sys:String x:Key="Settings_OcrModel_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Recognition model</sys:String>
    <sys:String x:Key="Settings_OcrModel_V6" xmlns:sys="clr-namespace:System;assembly=mscorlib">Newer model · recommended</sys:String>
    <sys:String x:Key="Settings_OcrModel_V4" xmlns:sys="clr-namespace:System;assembly=mscorlib">Older model · for compatibility</sys:String>
    <sys:String x:Key="Settings_OcrModel_V6_Description" xmlns:sys="clr-namespace:System;assembly=mscorlib">Best balance for modern PCs. More accurate on screen text and supports English and Japanese with one model. Switches to the compatibility model by itself if it cannot load.</sys:String>
    <sys:String x:Key="Settings_OcrModel_V4_Description" xmlns:sys="clr-namespace:System;assembly=mscorlib">Lighter model. Use it if V6 is unusually slow or incompatible on this PC.</sys:String>
    <sys:String x:Key="Settings_OcrModel_Restart" xmlns:sys="clr-namespace:System;assembly=mscorlib">Restart Kaption to switch models.</sys:String>
    <sys:String x:Key="Tip_Settings_OcrModel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Changes the local ONNX models used to detect and read game dialogue.</sys:String>
    <sys:String x:Key="Settings_OcrGpu_Checkbox" xmlns:sys="clr-namespace:System;assembly=mscorlib">Use GPU acceleration (DirectML)</sys:String>
    <sys:String x:Key="Tip_Settings_OcrGpu" xmlns:sys="clr-namespace:System;assembly=mscorlib">Runs text recognition on the graphics card. Kaption switches to the processor on its own if the GPU turns out to be too slow or unstable; tick this box again to give the GPU another try.</sys:String>
    <sys:String x:Key="Settings_OcrGpu_Quarantined" xmlns:sys="clr-namespace:System;assembly=mscorlib">Kaption is running text recognition on the processor because the GPU was too slow. Tick the box again to retry the GPU.</sys:String>
    <sys:String x:Key="Dash_GpuQuarantined" xmlns:sys="clr-namespace:System;assembly=mscorlib">Running on the processor: the graphics card was too slow at startup. Tick “Use GPU acceleration” under Help › Advanced to try it again.</sys:String>
    <sys:String x:Key="Dash_GpuUnavailable" xmlns:sys="clr-namespace:System;assembly=mscorlib">Running on the processor: the graphics card could not be started for translation. Updating the graphics driver usually fixes this; restart Kaption afterwards.</sys:String>
    <sys:String x:Key="Dash_GpuRetryNextLaunch" xmlns:sys="clr-namespace:System;assembly=mscorlib">Running on the processor this time: the graphics card was busy or slow while Kaption started. It gets another try at the next launch.</sys:String>

