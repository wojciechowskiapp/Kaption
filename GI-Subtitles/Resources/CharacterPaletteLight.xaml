<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- CharacterOverviewView colours, light. Same keys as CharacterPaletteDark.xaml (add a key to both); a host
         picks either, its layout comes from CharacterLayoutPage/Popup.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Tokens.xaml"/>
        <ResourceDictionary Source="../Themes/Chips.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Char_Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Char_Fg" Color="#111827"/>
    <SolidColorBrush x:Key="Char_FgMuted" Color="#4B5563"/>
    <SolidColorBrush x:Key="Char_FgSubtle" Color="#6B7280"/>
    <SolidColorBrush x:Key="Char_Accent" Color="#B45309"/>
    <SolidColorBrush x:Key="Char_Brand" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Char_CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Char_Ring" Color="#E4E7EE"/>
    <SolidColorBrush x:Key="Char_RingStrong" Color="#CDD3DD"/>
    <SolidColorBrush x:Key="Char_ChipBg" Color="#F4F5F8"/>
    <SolidColorBrush x:Key="Char_Divider" Color="#EBEEF3"/>
    <SolidColorBrush x:Key="Char_Hover" Color="#F4F5F8"/>
    <SolidColorBrush x:Key="Char_Selected" Color="#EEF0F4"/>
    <!-- Deep amber: 4.9:1 on white and 3:1 or more over the header's ambience wash (#C88A12 was 2.96:1 on white). -->
    <SolidColorBrush x:Key="Char_Rarity5" Color="#A16207"/>
    <SolidColorBrush x:Key="Char_Rarity4" Color="#7C3AED"/>
    <SolidColorBrush x:Key="Char_Skeleton" Color="#EBEEF3"/>
    <SolidColorBrush x:Key="Char_Pressed" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Char_Track" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Char_TooltipBg" Color="#111827"/>
    <SolidColorBrush x:Key="Char_TooltipRing" Color="#1F2937"/>
    <!-- A floating surface (the Ctrl+Q popup, if it is ever shown light). -->
    <SolidColorBrush x:Key="Char_Overlay" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="Char_OverlayRing" Color="#1A000000"/>

    <!-- The header over the character's ambience image: paper, so dark text keeps its contrast; the scene shows as a
         pale wash on the right, then the bottom melts into the panels. -->
    <LinearGradientBrush x:Key="Char_HeroScrim" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EBFFFFFF" Offset="0"/>
        <GradientStop Color="#E0FFFFFF" Offset="0.45"/>
        <GradientStop Color="#A6FFFFFF" Offset="0.72"/>
        <GradientStop Color="#8CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Char_HeroFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
        <GradientStop Color="#99FFFFFF" Offset="0.85"/>
        <GradientStop Color="#F2FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <sys:Boolean x:Key="Char_IsDark">False</sys:Boolean>
</ResourceDictionary>
