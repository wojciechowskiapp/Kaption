    <sys:String x:Key="Dash_Region_NotSet" xmlns:sys="clr-namespace:System;assembly=mscorlib">Jeszcze nie ustawiony. Gdy gra jest na ekranie, kliknij Wykryj automatycznie.</sys:String>
    <sys:String x:Key="Dash_QuickStart" xmlns:sys="clr-namespace:System;assembly=mscorlib">Szybki start: 1) Uruchom grę  2) Kliknij „Wybierz obszar"  3) Kliknij „Uruchom"</sys:String>
    <sys:String x:Key="Dialog_GameNotFound_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Gra nie jest uruchomiona</sys:String>
    <sys:String x:Key="Dialog_GameNotFound_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Kaption nie widzi okna gry. Odpal grę, zaczekaj na menu główne i kliknij „Uruchom".</sys:String>
    <sys:String x:Key="Dialog_GameNotFound_Details" xmlns:sys="clr-namespace:System;assembly=mscorlib">Grasz przez GeForce Now albo inną chmurę? Gra nie działa na tym komputerze, więc kliknij „Mimo to kontynuuj”, żeby wystartować.</sys:String>
    <sys:String x:Key="Dialog_GameNotFound_Primary" xmlns:sys="clr-namespace:System;assembly=mscorlib">Mimo to kontynuuj</sys:String>
