    <!-- Klucze "napisy zasłaniają dialog". JEDNA treść dla trzech miejsc:
         bramka przy Start, ostrzeżenie po zmianie regionu, czerwony alert
         runtime. Krótkie warianty dla Ctrl+Shift+D i hintów w okienku niżej. -->
    <sys:String x:Key="Dialog_OverlayInRegion_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">⚠ Napisy zasłaniają dialog gry</sys:String>
    <sys:String x:Key="Dialog_OverlayInRegion_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Okienko napisów zasłania dialog gry, więc Kaption zacząłby czytać własne tłumaczenie w nieskończonej pętli. Przeciągnij okienko w bok, zmień jego pozycję w Wyglądzie napisów albo wciśnij Ctrl+Shift+R, żeby zaznaczyć obszar dialogu od nowa. Tłumaczenie wróci, jak tylko okienko zejdzie z dialogu.</sys:String>
    <sys:String x:Key="Dialog_OverlayInRegion_Details" xmlns:sys="clr-namespace:System;assembly=mscorlib">Wciąż się nachodzi po przesunięciu? W Wygląd napisów › Maks. wysokość / Pionowo zmniejsz maksymalną wysokość napisów albo zwiększ odstęp pionowy, żeby okienko stało wyżej. Poradnik z rysunkami: kaption.one/pl/how-to/region#overlap</sys:String>
    <sys:String x:Key="Dialog_OverlayInRegion_Primary" xmlns:sys="clr-namespace:System;assembly=mscorlib">Mimo to kontynuuj</sys:String>
    <sys:String x:Key="Dialog_OverlayInRegion_Secondary" xmlns:sys="clr-namespace:System;assembly=mscorlib">Zaznacz ponownie</sys:String>
    <!-- Krótka etykieta dla Ctrl+Shift+D gdy nakładka zachodzi na obszar. -->
    <sys:String x:Key="Overlap_Badge_Warning" xmlns:sys="clr-namespace:System;assembly=mscorlib">⚠ Napisy zasłaniają dialog. Tłumaczenie tu nie zadziała.</sys:String>
    <!-- Teksty pokazywane WEWNĄTRZ okienka napisów w dwóch stanach "złap mnie". -->
    <sys:String x:Key="Runtime_OverlapDragHint" xmlns:sys="clr-namespace:System;assembly=mscorlib">⇕  Przeciągnij mnie poza obszar dialogu</sys:String>
    <sys:String x:Key="Runtime_ReadyPlaceholder" xmlns:sys="clr-namespace:System;assembly=mscorlib">⇕  Kaption jest gotowy. Przeciągnij mnie, żeby ustawić.</sys:String>

