    <sys:String x:Key="Dash_EngineFailed_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Tłumacz się nie wczytał</sys:String>
    <sys:String x:Key="Dash_EngineFailed_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Kaption nie uruchomił czytnika dialogów. Zwykle pomaga „Spróbuj ponownie”. Jeśli karta graficzna dalej się sypie, przełącz na procesor. Będzie wolniej, ale pewnie.</sys:String>
    <sys:String x:Key="Dash_EngineFailed_Retry" xmlns:sys="clr-namespace:System;assembly=mscorlib">Spróbuj ponownie</sys:String>
    <sys:String x:Key="Dash_EngineFailed_Retry_Tooltip" xmlns:sys="clr-namespace:System;assembly=mscorlib">Uruchom czytnik dialogów jeszcze raz z obecnymi ustawieniami.</sys:String>
    <sys:String x:Key="Dash_EngineFailed_CpuFallback" xmlns:sys="clr-namespace:System;assembly=mscorlib">Przełącz na CPU</sys:String>
    <sys:String x:Key="Dash_EngineFailed_CpuFallback_Tooltip" xmlns:sys="clr-namespace:System;assembly=mscorlib">Wyłącz akcelerację GPU i spróbuj ponownie. Na procesorze czytanie jest wolniejsze, ale omija kartę graficzną.</sys:String>
    <sys:String x:Key="Dash_EngineFailed_UnknownDetails" xmlns:sys="clr-namespace:System;assembly=mscorlib">Nieznany błąd.</sys:String>
    <sys:String x:Key="Dash_EngineFailed_Runtime_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Rozpoznawanie tekstu nie wystartowało</sys:String>
    <sys:String x:Key="Dash_EngineFailed_Runtime_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Windows nie wczytał komponentu, którego Kaption potrzebuje do odczytywania tekstu z ekranu (błąd {0}). Najpierw spróbuj zrestartować Kaption. Jeśli to się powtarza, sprawdź, czy antywirus nie wrzucił plików Kaption do kwarantanny, a potem przeinstaluj program ze strony kaption.one.</sys:String>
    <sys:String x:Key="Dash_EngineFailed_Restart" xmlns:sys="clr-namespace:System;assembly=mscorlib">Zrestartuj Kaption</sys:String>
    <sys:String x:Key="Dash_EngineFailed_Restart_Tooltip" xmlns:sys="clr-namespace:System;assembly=mscorlib">Zamknij i uruchom Kaption od nowa. Ten komponent da się wczytać jeszcze raz tylko przy świeżym starcie.</sys:String>
    <sys:String x:Key="Overlay_EngineLoading" xmlns:sys="clr-namespace:System;assembly=mscorlib">Uruchamiam czytnik dialogów…</sys:String>
    <sys:String x:Key="Overlay_EngineFailed" xmlns:sys="clr-namespace:System;assembly=mscorlib">Tłumacz się nie wczytał. Sprawdź ustawienia.</sys:String>
    <sys:String x:Key="Dialog_EngineLoading_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Tłumacz jeszcze się wczytuje</sys:String>
    <sys:String x:Key="Dialog_EngineLoading_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Daj mu chwilę, czytnik dialogów jeszcze się rozgrzewa. Kliknij Start ponownie, gdy plakietka pod przyciskiem pokaże „Gotowy”.</sys:String>
    <sys:String x:Key="Dialog_EngineFailed_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Tłumacz się nie wczytał</sys:String>
    <sys:String x:Key="Dialog_EngineFailed_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Czytnik dialogów nie wystartował. Otwórz Start i kliknij Spróbuj ponownie. Karta na Starcie pozwala też uruchomić go na procesorze, jeśli karta graficzna dalej się sypie.</sys:String>
