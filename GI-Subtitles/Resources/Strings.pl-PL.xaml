    <sys:String x:Key="Hotkey_9000_Info" xmlns:sys="clr-namespace:System;assembly=mscorlib">Główny włącznik. Naciśnij raz, a Kaption zacznie śledzić obszar dialogu i tłumaczyć to, co się w nim pojawia. Naciśnij drugi raz, żeby zatrzymać, gdy cutscenka albo zadanie się skończy. Działa jak duży przycisk na stronie Start. Skrót przydaje się, kiedy nie chcesz wychodzić z gry.</sys:String>
    <sys:String x:Key="Hotkey_9001_Info" xmlns:sys="clr-namespace:System;assembly=mscorlib">Przerysuj prostokąt, w którym Kaption szuka dialogów. Przydaje się po zmianie monitora, rozdzielczości, przełączeniu okno ↔ pełny ekran albo gdy napisy przestają się pojawiać mimo dialogów w grze.</sys:String>
    <sys:String x:Key="Hotkey_9002_Info" xmlns:sys="clr-namespace:System;assembly=mscorlib">Natychmiast chowa napisy na ekranie, ale nie zatrzymuje tłumaczenia. Pomocne przy screenach, filmowych scenach albo gdy interfejs gry zachodzi na pole napisów. Naciśnij drugi raz, a napisy wrócą. Tłumaczenie i tak działa w tle.</sys:String>
    <sys:String x:Key="Hotkey_9003_Info" xmlns:sys="clr-namespace:System;assembly=mscorlib">Mrugnie kolorową ramką w miejscu, w którym Kaption pilnuje dialogów. Szybka kontrola, czy obszar jest ustawiony tam, gdzie trzeba, zwłaszcza po zmianie rozdzielczości albo interfejsu gry.</sys:String>
    <sys:String x:Key="Hotkey_9004_Info" xmlns:sys="clr-namespace:System;assembly=mscorlib">Wymusza natychmiastowe tłumaczenie bieżącej klatki, nawet jeśli tekst się nie zmienił. Przydatne, gdy Kaption utknął na starej linii (np. animacja pisania poszła dalej, a dopasowanie nie nadążyło) albo po zmianie ustawień. Nie trzeba zatrzymywać tłumaczenia.</sys:String>
    <sys:String x:Key="Hotkey_9005_Info" xmlns:sys="clr-namespace:System;assembly=mscorlib">Zaznaczasz ramką dowolny fragment ekranu, np. opis przedmiotu, tytuł zadania albo pozycję w menu, a Kaption pokazuje obok tłumaczenie. Działa niezależnie od obszaru dialogu, więc obsługuje też teksty spoza dymków.</sys:String>

    <sys:String x:Key="Hotkeys_Group_Primary" xmlns:sys="clr-namespace:System;assembly=mscorlib">SKRÓTY CODZIENNE</sys:String>
    <sys:String x:Key="Hotkeys_Group_Advanced" xmlns:sys="clr-namespace:System;assembly=mscorlib">SKRÓTY ZAAWANSOWANE</sys:String>
    <sys:String x:Key="Hotkeys_Info_Tooltip" xmlns:sys="clr-namespace:System;assembly=mscorlib">Kiedy to się przyda?</sys:String>
    <sys:String x:Key="Config_OcrSpeed_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Prędkość tłumaczenia</sys:String>
    <sys:String x:Key="Config_OcrInterval" xmlns:sys="clr-namespace:System;assembly=mscorlib">Interwał skanowania (ms):</sys:String>
    <sys:String x:Key="Config_UiRefresh" xmlns:sys="clr-namespace:System;assembly=mscorlib">Odświeżanie UI (ms):</sys:String>
    <sys:String x:Key="Config_OcrSpeed_Hint" xmlns:sys="clr-namespace:System;assembly=mscorlib">Mniej = szybsze napisy, więcej = mniejsze obciążenie CPU</sys:String>
    <sys:String x:Key="Settings_OcrModel_Card_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Model rozpoznawania tekstu</sys:String>
    <sys:String x:Key="Settings_OcrModel_Card_Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">Wybierz, jak Kaption odczytuje dialogi z gry. Rekomendowany model lepiej rozpoznaje tekst ekranowy, a tryb zgodności zachowuje poprzedni, lżejszy silnik.</sys:String>
    <sys:String x:Key="Settings_OcrModel_Label" xmlns:sys="clr-namespace:System;assembly=mscorlib">Model rozpoznawania</sys:String>
    <sys:String x:Key="Settings_OcrModel_V6" xmlns:sys="clr-namespace:System;assembly=mscorlib">Nowszy model · polecany</sys:String>
    <sys:String x:Key="Settings_OcrModel_V4" xmlns:sys="clr-namespace:System;assembly=mscorlib">Starszy model · dla zgodności</sys:String>
    <sys:String x:Key="Settings_OcrModel_V6_Description" xmlns:sys="clr-namespace:System;assembly=mscorlib">Najlepszy balans dla współczesnych komputerów. Dokładniej czyta tekst ekranowy i obsługuje angielski oraz japoński jednym modelem. Jeśli nie wystartuje, aplikacja automatycznie wróci do V4.</sys:String>
    <sys:String x:Key="Settings_OcrModel_V4_Description" xmlns:sys="clr-namespace:System;assembly=mscorlib">Poprzedni, lekki model. Wybierz go, jeśli V6 działa na tym komputerze nietypowo wolno albo niekompatybilnie.</sys:String>
    <sys:String x:Key="Settings_OcrModel_Restart" xmlns:sys="clr-namespace:System;assembly=mscorlib">Uruchom Kaption ponownie, żeby przełączyć model.</sys:String>
    <sys:String x:Key="Tip_Settings_OcrModel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Zmienia lokalne modele ONNX używane do wykrywania i odczytywania dialogów z gry.</sys:String>
    <sys:String x:Key="Settings_OcrGpu_Checkbox" xmlns:sys="clr-namespace:System;assembly=mscorlib">Używaj akceleracji GPU (DirectML)</sys:String>
    <sys:String x:Key="Tip_Settings_OcrGpu" xmlns:sys="clr-namespace:System;assembly=mscorlib">Rozpoznaje tekst na karcie graficznej. Jeśli GPU okaże się za wolne albo niestabilne, Kaption sam przełączy się na procesor; zaznacz to pole ponownie, żeby dać GPU jeszcze jedną szansę.</sys:String>
    <sys:String x:Key="Settings_OcrGpu_Quarantined" xmlns:sys="clr-namespace:System;assembly=mscorlib">Kaption rozpoznaje tekst na procesorze, bo karta graficzna była za wolna. Zaznacz pole ponownie, żeby spróbować z GPU.</sys:String>
    <sys:String x:Key="Dash_GpuQuarantined" xmlns:sys="clr-namespace:System;assembly=mscorlib">Działa na procesorze, bo karta graficzna była za wolna przy starcie. Zaznacz „Używaj akceleracji GPU” w Pomoc › Zaawansowane, żeby spróbować ponownie.</sys:String>
    <sys:String x:Key="Dash_GpuUnavailable" xmlns:sys="clr-namespace:System;assembly=mscorlib">Działa na procesorze, bo nie udało się uruchomić karty graficznej do tłumaczenia. Zwykle pomaga aktualizacja sterownika karty, potem uruchom Kaption ponownie.</sys:String>
    <sys:String x:Key="Dash_GpuRetryNextLaunch" xmlns:sys="clr-namespace:System;assembly=mscorlib">Tym razem działa na procesorze, bo karta graficzna była zajęta albo wolna przy starcie. Przy następnym uruchomieniu Kaption spróbuje znowu.</sys:String>

