<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- CharacterOverviewView colours, dark (the Ctrl+Q popup, or a dark-themed page), on the kaption.one ink ramp.
         Same keys as CharacterPaletteLight.xaml, plus scroll thumbs for a dark surface. The popup replaces
         Char_Accent per game. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Tokens.xaml"/>
        <ResourceDictionary Source="../Themes/Chips.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Char_Surface" Color="#0B0D17"/>
    <SolidColorBrush x:Key="Char_Fg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Char_FgMuted" Color="#B4BBC7"/>
    <SolidColorBrush x:Key="Char_FgSubtle" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Char_Accent" Color="#F2B84B"/>
    <SolidColorBrush x:Key="Char_Brand" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="Char_CardBg" Color="#0F1220"/>
    <SolidColorBrush x:Key="Char_Ring" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Char_RingStrong" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="Char_ChipBg" Color="#181C2A"/>
    <SolidColorBrush x:Key="Char_Divider" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Char_Hover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Char_Selected" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Char_Rarity5" Color="#F2C46D"/>
    <SolidColorBrush x:Key="Char_Rarity4" Color="#C4A7F5"/>
    <SolidColorBrush x:Key="Char_Skeleton" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Char_Pressed" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Char_Track" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Char_TooltipBg" Color="#181C2A"/>
    <SolidColorBrush x:Key="Char_TooltipRing" Color="#232838"/>
    <!-- A floating surface over the game (the Ctrl+Q popup): ink at 94% with a hairline ring. -->
    <SolidColorBrush x:Key="Char_Overlay" Color="#F00B0D17"/>
    <SolidColorBrush x:Key="Char_OverlayRing" Color="#26FFFFFF"/>
    <!-- The header over the character's ambience image: ink, heavier where the name and chips sit, the scene showing at
         about half strength on the right; then the bottom melting into the panels. -->
    <LinearGradientBrush x:Key="Char_HeroScrim" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D10B0D17" Offset="0"/>
        <GradientStop Color="#C70B0D17" Offset="0.45"/>
        <GradientStop Color="#8C0B0D17" Offset="0.72"/>
        <GradientStop Color="#730B0D17" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Char_HeroFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B0D17" Offset="0.5"/>
        <GradientStop Color="#990B0D17" Offset="0.85"/>
        <GradientStop Color="#F20B0D17" Offset="1"/>
    </LinearGradientBrush>
    <!-- Scroll thumbs readable on this surface (Themes/ScrollBars.xaml reads these keys). -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF"/>

    <sys:Boolean x:Key="Char_IsDark">True</sys:Boolean>
</ResourceDictionary>
