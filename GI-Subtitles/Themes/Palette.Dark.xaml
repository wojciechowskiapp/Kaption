<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ink palette, the default: the site's surfaces (ink-950 canvas, ink-850 cards, ink-800 bars) and
         white/8 hairlines. Same keys as Palette.Light.xaml. Tints are translucent so they sit on any surface. -->

    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#818CF8</Color>
    <Color x:Key="AccentPressedColor">#4F46E5</Color>
    <Color x:Key="AccentLightColor">#296366F1</Color>
    <Color x:Key="BgColor">#0B0D17</Color>
    <Color x:Key="SurfaceColor">#121522</Color>
    <Color x:Key="Surface2Color">#181C2A</Color>
    <Color x:Key="CardBorderColor">#14FFFFFF</Color>
    <Color x:Key="BorderColor">#29FFFFFF</Color>
    <Color x:Key="BorderFocusColor">#818CF8</Color>
    <Color x:Key="TextColor">#E5E7EB</Color>
    <Color x:Key="TextSecondaryColor">#C0C5CF</Color>
    <Color x:Key="TextTertiaryColor">#9CA3AF</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>
    <Color x:Key="InfoColor">#60A5FA</Color>
    <Color x:Key="DebugColor">#9CA3AF</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="LogHeaderBgColor">#181C2A</Color>
    <Color x:Key="LogAltRowColor">#06FFFFFF</Color>
    <Color x:Key="SuccessLightColor">#2434D399</Color>
    <Color x:Key="InfoLightColor">#2460A5FA</Color>
    <Color x:Key="WarnLightColor">#24F59E0B</Color>
    <Color x:Key="ErrorLightColor">#24F87171</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#406366F1"/>
    <!-- Indigo 500 is 4.1:1 on ink as text, so text and filled buttons get their own steps. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="AccentFillBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#5B5BEF"/>
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#4338CA"/>
    <!-- A screen's one primary action (Start's "Uruchom", the sign-in button, setup's last step): the brand gradient of
         Tokens.xaml under white text, 5:1 or more on every stop. A palette key rather than the token so that high contrast
         maps it to the system highlight with the rest of the AccentFill keys. -->
    <LinearGradientBrush x:Key="AccentFillHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillHeroHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D4ED8" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <!-- The rail's active indicator in the current game's colour (the games' own accents). -->
    <SolidColorBrush x:Key="RailIndicatorGenshinBrush" Color="#F2B84B"/>
    <SolidColorBrush x:Key="RailIndicatorStarRailBrush" Color="#6FD6E8"/>
    <SolidColorBrush x:Key="RailIndicatorZzzBrush" Color="#C9CEDC"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#47FFFFFF"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="DebugBrush" Color="{StaticResource DebugColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="LogHeaderBgBrush" Color="{StaticResource LogHeaderBgColor}"/>
    <SolidColorBrush x:Key="LogAltRowBrush" Color="{StaticResource LogAltRowColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLightColor}"/>
    <SolidColorBrush x:Key="WarnLightBrush" Color="{StaticResource WarnLightColor}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLightColor}"/>
    <!-- The site's focus colour (#93C5FD) reads on ink; indigo would not. -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="FocusHaloBrush" Color="#4D93C5FD"/>
    <SolidColorBrush x:Key="TooltipBgBrush" Color="#232838"/>
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ElevationBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="SkeletonBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C"/>
</ResourceDictionary>
