<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light semantic palette. Same keys as Palette.Dark.xaml; ThemeService swaps one for the other at app
         level, so views reference these keys with DynamicResource. GI-Test/PaletteContrastTests checks AA. -->

    <Color x:Key="AccentColor">#4F46E5</Color>
    <Color x:Key="AccentHoverColor">#4338CA</Color>
    <Color x:Key="AccentPressedColor">#3730A3</Color>
    <Color x:Key="AccentLightColor">#EEF2FF</Color>
    <Color x:Key="BgColor">#F7F8FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#F1F3F7</Color>
    <Color x:Key="CardBorderColor">#E4E7EE</Color>
    <Color x:Key="BorderColor">#CDD3DD</Color>
    <Color x:Key="BorderFocusColor">#6366F1</Color>
    <Color x:Key="TextColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#4B5563</Color>
    <!-- #6B7280 was 4.35:1 on Surface2 (title and status bars); one step darker passes everywhere. -->
    <Color x:Key="TextTertiaryColor">#636A78</Color>
    <!-- Red 700: Red 600 was 4.29:1 on its own tint. -->
    <Color x:Key="ErrorColor">#B91C1C</Color>
    <Color x:Key="WarnColor">#B45309</Color>
    <Color x:Key="InfoColor">#2563EB</Color>
    <Color x:Key="DebugColor">#636A78</Color>
    <Color x:Key="SuccessColor">#047857</Color>
    <Color x:Key="LogHeaderBgColor">#F1F3F7</Color>
    <Color x:Key="LogAltRowColor">#F7F8FC</Color>
    <Color x:Key="SuccessLightColor">#E9F7F0</Color>
    <Color x:Key="InfoLightColor">#EAF1FE</Color>
    <Color x:Key="WarnLightColor">#FFF7E6</Color>
    <Color x:Key="ErrorLightColor">#FDEEEE</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E0E7FF"/>
    <!-- Accent as text (links, selected labels) and as a fill under white text (filled buttons). -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentFillBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#3730A3"/>
    <!-- A screen's one primary action (Start's "Uruchom", the sign-in button, setup's last step): the brand gradient of
         Tokens.xaml under white text, 5:1 or more on every stop. A palette key rather than the token so that high contrast
         maps it to the system highlight with the rest of the AccentFill keys. -->
    <LinearGradientBrush x:Key="AccentFillHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFillHeroHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D4ED8" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <!-- The rail's active indicator in the current game's colour (the games' accents deepened to 4:1 or more on the selected item). -->
    <SolidColorBrush x:Key="RailIndicatorGenshinBrush" Color="#A86A05"/>
    <SolidColorBrush x:Key="RailIndicatorStarRailBrush" Color="#0B7C90"/>
    <SolidColorBrush x:Key="RailIndicatorZzzBrush" Color="#5B6272"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F1F3F7"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#EBEEF3"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EBEEF3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="DebugBrush" Color="{StaticResource DebugColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="LogHeaderBgBrush" Color="{StaticResource LogHeaderBgColor}"/>
    <SolidColorBrush x:Key="LogAltRowBrush" Color="{StaticResource LogAltRowColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLightColor}"/>
    <SolidColorBrush x:Key="WarnLightBrush" Color="{StaticResource WarnLightColor}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLightColor}"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="FocusHaloBrush" Color="#406366F1"/>
    <SolidColorBrush x:Key="TooltipBgBrush" Color="#181C2A"/>
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#232838"/>
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33111827"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66111827"/>
    <SolidColorBrush x:Key="ElevationBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#D5DAE3"/>
    <SolidColorBrush x:Key="SkeletonBrush" Color="#E9ECF2"/>
    <!-- Window frame and caption buttons; close turns red on hover in both themes (Windows convention). -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#CDD3DD"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E4E7EE"/>
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#C42B1C"/>
</ResourceDictionary>
