<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Kaption design tokens that do not change with the theme: ramps shared with kaption.one, type, spacing,
         radii, focus, the brand mark and line icons. Semantic colours (TextBrush, SurfaceBrush, ...) live in
         Palette.Dark.xaml / Palette.Light.xaml, which ThemeService swaps at app level; never redefine them in a
         dictionary a window merges, or that window stops following the theme. Keys have no dots
         (tools/validate-xaml-resources.ps1 reads [A-Za-z0-9_] only). -->

    <!-- ── Ramps ── -->
    <Color x:Key="Ink950">#0B0D17</Color>
    <Color x:Key="Ink900">#0F1220</Color>
    <Color x:Key="Ink850">#121522</Color>
    <Color x:Key="Ink800">#181C2A</Color>
    <Color x:Key="Ink700">#232838</Color>

    <Color x:Key="Gray50">#F7F8FC</Color>
    <Color x:Key="Gray100">#F1F3F7</Color>
    <Color x:Key="Gray150">#EBEEF3</Color>
    <Color x:Key="Gray200">#E4E7EE</Color>
    <Color x:Key="Gray300">#CDD3DD</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray900">#111827</Color>

    <Color x:Key="Indigo50">#EEF2FF</Color>
    <Color x:Key="Indigo100">#E0E7FF</Color>
    <Color x:Key="Indigo300">#A5B4FC</Color>
    <Color x:Key="Indigo500">#6366F1</Color>
    <Color x:Key="Indigo600">#4F46E5</Color>
    <Color x:Key="Indigo700">#4338CA</Color>
    <Color x:Key="Indigo800">#3730A3</Color>

    <Color x:Key="Amber50">#FFF7E6</Color>
    <Color x:Key="Amber500">#F59E0B</Color>
    <Color x:Key="Amber700">#B45309</Color>
    <Color x:Key="Emerald50">#E9F7F0</Color>
    <Color x:Key="Emerald700">#047857</Color>
    <Color x:Key="Red50">#FDEEEE</Color>
    <Color x:Key="Red600">#DC2626</Color>
    <Color x:Key="Blue50">#EAF1FE</Color>
    <Color x:Key="Blue600">#2563EB</Color>
    <Color x:Key="Blue300">#93C5FD</Color>
    <Color x:Key="Violet600">#7C3AED</Color>

    <SolidColorBrush x:Key="Ink950Brush" Color="{StaticResource Ink950}"/>
    <SolidColorBrush x:Key="Ink900Brush" Color="{StaticResource Ink900}"/>
    <SolidColorBrush x:Key="Ink850Brush" Color="{StaticResource Ink850}"/>
    <SolidColorBrush x:Key="Ink800Brush" Color="{StaticResource Ink800}"/>
    <SolidColorBrush x:Key="Ink700Brush" Color="{StaticResource Ink700}"/>

    <!-- Game accents from the site's games data (landing/src/data/games.ts); used on ink only (band edge, dots). -->
    <Color x:Key="GameGenshinColor">#F2B84B</Color>
    <Color x:Key="GameStarRailColor">#6FD6E8</Color>
    <Color x:Key="GameZzzColor">#C9CEDC</Color>
    <SolidColorBrush x:Key="GameGenshinBrush" Color="{StaticResource GameGenshinColor}"/>
    <SolidColorBrush x:Key="GameStarRailBrush" Color="{StaticResource GameStarRailColor}"/>
    <SolidColorBrush x:Key="GameZzzBrush" Color="{StaticResource GameZzzColor}"/>
    <!-- Per-game atmosphere: the glow behind the Start hero (Genshin warm gold, Star Rail blue, ZZZ orange). -->
    <Color x:Key="GameGenshinGlowColor">#F2B84B</Color>
    <Color x:Key="GameStarRailGlowColor">#4F8DFF</Color>
    <Color x:Key="GameZzzGlowColor">#FF8A2B</Color>

    <!-- ── Subtitle overlay: always drawn over the game, so the same in both themes (Services/Rendering/OverlayTokens). ── -->
    <Color x:Key="OverlayPanelColor">#000000</Color>
    <Color x:Key="OverlayTextColor">#FFFFFF</Color>
    <!-- The soft outline (1 px at 22 px) and the 2 px drop under it. -->
    <Color x:Key="OverlayOutlineColor">#D9000000</Color>
    <Color x:Key="OverlayShadowColor">#73000000</Color>
    <!-- Name tag: a neutral pill unless the speaker's element is known. -->
    <Color x:Key="OverlayNameFillColor">#29FFFFFF</Color>
    <Color x:Key="OverlayNameTextColor">#F2F4F8</Color>
    <Color x:Key="OverlayAnswerColor">#B0E8D8A0</Color>
    <Color x:Key="OverlaySeparatorColor">#30FFFFFF</Color>
    <!-- The looks' sample tiles: a bright scene (sky over stone), where the outline and the panel make their difference. -->
    <!-- Setup's "how it works" frames (Views/Shell/HowItWorksFrame): a game scene at dusk with its dialogue box. -->
    <Color x:Key="IllustrationSkyTopColor">#26304A</Color>
    <Color x:Key="IllustrationSkyBottomColor">#5C6F8F</Color>
    <Color x:Key="IllustrationHillColor">#1C2333</Color>
    <Color x:Key="IllustrationDialogueColor">#CC0F1220</Color>
    <Color x:Key="IllustrationNameColor">#F2C46D</Color>
    <Color x:Key="IllustrationTextColor">#E6FFFFFF</Color>
    <Color x:Key="OverlaySwatchSkyColor">#9DB7D0</Color>
    <Color x:Key="OverlaySwatchGroundColor">#E4D8C2</Color>
    <!-- Settings miniature: the saved dialogue area as a faint outline, with grey lines for the game's own text. -->
    <Color x:Key="OverlayPreviewBandColor">#400B0D17</Color>
    <Color x:Key="OverlayPreviewBandLineColor">#73FFFFFF</Color>
    <Color x:Key="OverlayPreviewTextLineColor">#8CC9CED8</Color>

    <!-- The one brand gradient (kaption.one .k-btn-primary), for the mark and the brand accents. The primary action button
         wears the palettes' copy of it (AccentFillHeroBrush and its hover), which high contrast maps to system colours. -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Blue600}" Offset="0"/>
        <GradientStop Color="{StaticResource Violet600}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Type ── -->
    <FontFamily x:Key="FontBody">Segoe UI</FontFamily>
    <!-- Bahnschrift (DIN, ships with Windows 10 1709+) for headings and numerals; falls back to Segoe UI. -->
    <FontFamily x:Key="FontDisplay">Bahnschrift, Segoe UI</FontFamily>
    <!-- Window titles: Segoe UI Variable on Windows 11, Segoe UI on 10 (no Archivo ships with the app). -->
    <FontFamily x:Key="FontTitle">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeHeadline">20</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>

    <!-- ── Spacing: 4 / 8 / 12 / 16 / 24 / 32 ── -->
    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">12</Thickness>
    <Thickness x:Key="SpaceL">16</Thickness>
    <Thickness x:Key="SpaceXL">24</Thickness>
    <Thickness x:Key="Space2XL">32</Thickness>
    <sys:Double x:Key="Gap4">4</sys:Double>
    <sys:Double x:Key="Gap8">8</sys:Double>
    <sys:Double x:Key="Gap12">12</sys:Double>
    <sys:Double x:Key="Gap16">16</sys:Double>
    <sys:Double x:Key="Gap24">24</sys:Double>
    <sys:Double x:Key="Gap32">32</sys:Double>
    <!-- One height scale: inputs and buttons 36, the screen's primary action 44, comfortable target 32+. -->
    <sys:Double x:Key="TargetMin">32</sys:Double>
    <sys:Double x:Key="ControlHeight">36</sys:Double>
    <sys:Double x:Key="ControlHeightLarge">44</sys:Double>

    <!-- ── Radii: controls < cards < panels ── -->
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusButton">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ── Elevation: flat 1px borders, no blur. ── -->
    <Thickness x:Key="BorderHairline">1</Thickness>

    <!-- ── Focus: keyboard only (WPF shows FocusVisualStyle for keyboard focus), drawn outside the control. ── -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Brand mark (landing/public/favicon.svg) as a vector, sharp at any DPI. ── -->
    <DrawingImage x:Key="KaptionMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrandGradientBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M9,7 H12 V14.2 L17.6,7 H21.2 L15.4,15 L21.8,25 H18 L13.2,17.4 L11,20 V25 H8 V7 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.95"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.5"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="9,27.2,6,1.4" RadiusX="0.7" RadiusY="0.7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.3"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="16.5,27.2,6.5,1.4" RadiusX="0.7" RadiusY="0.7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

