<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Kaption design tokens. Ramps are shared with kaption.one; the windows use the light semantic palette
         below, the Ctrl+Q popup maps the ink ramp in Resources/CharacterPaletteDark.xaml. Keys have no dots
         (tools/validate-xaml-resources.ps1 reads [A-Za-z0-9_] only). -->

    <!-- ── Ramps ── -->
    <Color x:Key="Ink950">#0B0D17</Color>
    <Color x:Key="Ink900">#0F1220</Color>
    <Color x:Key="Ink850">#121522</Color>
    <Color x:Key="Ink800">#181C2A</Color>
    <Color x:Key="Ink700">#232838</Color>

    <Color x:Key="Gray50">#F7F8FC</Color>
    <Color x:Key="Gray100">#F1F3F7</Color>
    <Color x:Key="Gray150">#EBEEF3</Color>
    <Color x:Key="Gray200">#E4E7EE</Color>
    <Color x:Key="Gray300">#CDD3DD</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray900">#111827</Color>

    <Color x:Key="Indigo50">#EEF2FF</Color>
    <Color x:Key="Indigo100">#E0E7FF</Color>
    <Color x:Key="Indigo300">#A5B4FC</Color>
    <Color x:Key="Indigo500">#6366F1</Color>
    <Color x:Key="Indigo600">#4F46E5</Color>
    <Color x:Key="Indigo700">#4338CA</Color>
    <Color x:Key="Indigo800">#3730A3</Color>

    <Color x:Key="Amber50">#FFF7E6</Color>
    <Color x:Key="Amber500">#F59E0B</Color>
    <Color x:Key="Amber700">#B45309</Color>
    <Color x:Key="Emerald50">#E9F7F0</Color>
    <Color x:Key="Emerald700">#047857</Color>
    <Color x:Key="Red50">#FDEEEE</Color>
    <Color x:Key="Red600">#DC2626</Color>
    <Color x:Key="Blue50">#EAF1FE</Color>
    <Color x:Key="Blue600">#2563EB</Color>
    <Color x:Key="Blue300">#93C5FD</Color>
    <Color x:Key="Violet600">#7C3AED</Color>

    <!-- ── Light palette (Settings, wizard, dialogs). Key names predate the tokens; views use them. ── -->
    <Color x:Key="AccentColor">#4F46E5</Color>
    <Color x:Key="AccentHoverColor">#4338CA</Color>
    <Color x:Key="AccentPressedColor">#3730A3</Color>
    <Color x:Key="AccentLightColor">#EEF2FF</Color>
    <Color x:Key="BgColor">#F7F8FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#E4E7EE</Color>
    <Color x:Key="BorderColor">#CDD3DD</Color>
    <Color x:Key="BorderFocusColor">#6366F1</Color>
    <Color x:Key="TextColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#4B5563</Color>
    <!-- 4.8:1 on white; the old #9CA3AF failed contrast for the hints that use it. -->
    <Color x:Key="TextTertiaryColor">#6B7280</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="WarnColor">#B45309</Color>
    <Color x:Key="InfoColor">#2563EB</Color>
    <Color x:Key="DebugColor">#6B7280</Color>
    <Color x:Key="SuccessColor">#047857</Color>
    <Color x:Key="LogHeaderBgColor">#F1F3F7</Color>
    <Color x:Key="LogAltRowColor">#F7F8FC</Color>
    <Color x:Key="SuccessLightColor">#E9F7F0</Color>
    <Color x:Key="InfoLightColor">#EAF1FE</Color>
    <Color x:Key="WarnLightColor">#FFF7E6</Color>
    <Color x:Key="ErrorLightColor">#FDEEEE</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource Indigo100}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource Gray150}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Gray150}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="DebugBrush" Color="{StaticResource DebugColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="LogHeaderBgBrush" Color="{StaticResource LogHeaderBgColor}"/>
    <SolidColorBrush x:Key="LogAltRowBrush" Color="{StaticResource LogAltRowColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLightColor}"/>
    <SolidColorBrush x:Key="WarnLightBrush" Color="{StaticResource WarnLightColor}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLightColor}"/>
    <SolidColorBrush x:Key="Ink950Brush" Color="{StaticResource Ink950}"/>
    <SolidColorBrush x:Key="Ink900Brush" Color="{StaticResource Ink900}"/>
    <SolidColorBrush x:Key="Ink850Brush" Color="{StaticResource Ink850}"/>
    <SolidColorBrush x:Key="Ink800Brush" Color="{StaticResource Ink800}"/>
    <SolidColorBrush x:Key="Ink700Brush" Color="{StaticResource Ink700}"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource Indigo500}"/>
    <SolidColorBrush x:Key="TooltipBgBrush" Color="{StaticResource Ink800}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33111827"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66111827"/>

    <!-- The one brand gradient (kaption.one .k-btn-primary): only on a screen's single primary action. -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Blue600}" Offset="0"/>
        <GradientStop Color="{StaticResource Violet600}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D4ED8" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Type ── -->
    <FontFamily x:Key="FontBody">Segoe UI</FontFamily>
    <!-- Bahnschrift (DIN, ships with Windows 10 1709+) for headings and numerals; falls back to Segoe UI. -->
    <FontFamily x:Key="FontDisplay">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeHeadline">20</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>

    <!-- ── Spacing: 4 / 8 / 12 / 16 / 24 / 32 ── -->
    <Thickness x:Key="SpaceXS">4</Thickness>
    <Thickness x:Key="SpaceS">8</Thickness>
    <Thickness x:Key="SpaceM">12</Thickness>
    <Thickness x:Key="SpaceL">16</Thickness>
    <Thickness x:Key="SpaceXL">24</Thickness>
    <Thickness x:Key="Space2XL">32</Thickness>
    <sys:Double x:Key="Gap4">4</sys:Double>
    <sys:Double x:Key="Gap8">8</sys:Double>
    <sys:Double x:Key="Gap12">12</sys:Double>
    <sys:Double x:Key="Gap16">16</sys:Double>
    <sys:Double x:Key="Gap24">24</sys:Double>
    <sys:Double x:Key="Gap32">32</sys:Double>
    <!-- Smallest comfortable click target. -->
    <sys:Double x:Key="TargetMin">32</sys:Double>

    <!-- ── Radii: controls < cards < panels ── -->
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusButton">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ── Elevation: flat 1px borders, no blur. ── -->
    <Thickness x:Key="BorderHairline">1</Thickness>
    <SolidColorBrush x:Key="ElevationBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#D5DAE3"/>

    <!-- ── Focus: keyboard only (WPF shows FocusVisualStyle for keyboard focus), drawn outside the control. ── -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"
                               Stroke="{StaticResource FocusRingBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="1" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True"
                               Stroke="{StaticResource FocusRingBrush}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Brand mark (landing/public/favicon.svg) as a vector, sharp at any DPI. ── -->
    <DrawingImage x:Key="KaptionMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource BrandGradientBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M9,7 H12 V14.2 L17.6,7 H21.2 L15.4,15 L21.8,25 H18 L13.2,17.4 L11,20 V25 H8 V7 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.95"/>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.5"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="9,27.2,6,1.4" RadiusX="0.7" RadiusY="0.7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.3"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="16.5,27.2,6.5,1.4" RadiusX="0.7" RadiusY="0.7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ── Line icons on a 16×16 grid (stroke 1.5), for buttons and empty states. ── -->
    <Geometry x:Key="IconChevronDown">M4,6 L8,10 L12,6</Geometry>
    <Geometry x:Key="IconChevronRight">M6,4 L10,8 L6,12</Geometry>
    <Geometry x:Key="IconCheck">M3.5,8.5 L6.5,11.5 L12.5,4.5</Geometry>
    <Geometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</Geometry>
    <Geometry x:Key="IconSearch">M10.5,10.5 L14,14 M11.5,7 A4.5,4.5 0 1 1 2.5,7 A4.5,4.5 0 1 1 11.5,7 Z</Geometry>
    <Geometry x:Key="IconRetry">M13,8 A5,5 0 1 1 11.5,4.4 M13,2.5 V5.5 H10</Geometry>
    <Geometry x:Key="IconWarning">M8,2 L14.5,13.5 H1.5 Z M8,6.5 V9.5 M8,11.6 V11.7</Geometry>
    <Geometry x:Key="IconPeople">M6,7.5 A2.5,2.5 0 1 1 6,2.5 A2.5,2.5 0 1 1 6,7.5 Z M1.5,13.5 C1.5,10.8 3.5,9.5 6,9.5 C8.5,9.5 10.5,10.8 10.5,13.5 M10.5,2.7 A2.4,2.4 0 0 1 10.5,7.3 M12,9.8 C13.6,10.3 14.5,11.6 14.5,13.5</Geometry>
</ResourceDictionary>
