<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- What Kaption's small windows over the game share: the Ctrl+Q popup and the in-game hint card's strip.
         The dark tooltip, the icon buttons (QtIconButton, QtIconToggle) and the text button (QtTextButton).
         The host merges Resources/CharacterPaletteDark.xaml before this file. -->
    <!-- Every colour comes from the palette's semantic keys (CharacterPaletteDark.xaml). -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Char_Fg}"/>
        <Setter Property="Background" Value="{DynamicResource Char_TooltipBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Char_TooltipRing}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QtIconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Char_FgMuted}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Char_Fg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QtIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource QtIconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Char_Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A text button in the header ("Wróć do tłumaczenia"). -->
    <Style x:Key="QtTextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Char_FgMuted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="4,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Char_Fg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Char_Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
