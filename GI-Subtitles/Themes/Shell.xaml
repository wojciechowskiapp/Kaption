<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:GI_Subtitles.Views.Shell">
    <!-- App shell pieces shared by every window: window chrome and title bar, the navigation rail, status chips,
         keyboard chips, skeletons, page layout and the "Zaawansowane" disclosure. Colours are semantic palette keys
         (DynamicResource) so the theme switches live; sizes come from Tokens.xaml. Only keyed styles, apart from the
         TitleBar control's own look, so nothing here restyles a window that does not opt in. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <shell:AccessKeyTextConverter x:Key="AccessKeyText"/>

    <!-- ═══ Window ═══ -->
    <Style x:Key="KaptionWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="shell:ShellWindow.UseChrome" Value="True"/>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontIcon}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar: mark, title, muted subtitle (version), caption buttons; surface-2 band with a hairline below. -->
    <Style TargetType="shell:TitleBar">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shell:TitleBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
                                <Image Source="{StaticResource KaptionMark}" Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Title}" Margin="10,0,0,1" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontTitle}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="subtitle" Text="{TemplateBinding Subtitle}" Margin="8,0,0,1"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding ExtraContent}" VerticalAlignment="Center"
                                              Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button x:Name="PART_Minimize" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                                        ToolTip="{DynamicResource shell_Caption_Minimize}"
                                        AutomationProperties.Name="{DynamicResource shell_Caption_Minimize}"/>
                                <Button x:Name="PART_Maximize" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                        ToolTip="{DynamicResource shell_Caption_Maximize}"
                                        AutomationProperties.Name="{DynamicResource shell_Caption_Maximize}"/>
                                <Button x:Name="PART_Close" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                                        ToolTip="{DynamicResource shell_Caption_Close}"
                                        AutomationProperties.Name="{DynamicResource shell_Caption_Close}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="subtitle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="CanMinimize" Value="False">
                            <Setter TargetName="PART_Minimize" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="CanMaximize" Value="False">
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="CanClose" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMaximized" Value="True">
                            <Setter TargetName="PART_Maximize" Property="Content" Value="&#xE923;"/>
                            <Setter TargetName="PART_Maximize" Property="ToolTip" Value="{DynamicResource shell_Caption_Restore}"/>
                            <Setter TargetName="PART_Maximize" Property="AutomationProperties.Name" Value="{DynamicResource shell_Caption_Restore}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Navigation rail (a TabControl; see Views/Shell/NavRail.cs) ═══ -->
    <Style x:Key="RailTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="shell:NavRail.CompactBelow" Value="1000"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="rail" Width="220" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0"
                                AutomationProperties.Name="{DynamicResource shell_Nav_Name}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="8,12"
                                            KeyboardNavigation.TabNavigation="Once"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"
                                          KeyboardNavigation.TabNavigation="Local"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shell:NavRail.IsCompact" Value="True">
                            <Setter TargetName="rail" Property="Width" Value="64"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RailTabItem" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="AutomationProperties.Name"
                Value="{Binding Header, RelativeSource={RelativeSource Self}, Converter={StaticResource AccessKeyText}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="root" MinHeight="40" Margin="0,0,0,2" Background="Transparent" Cursor="Hand"
                          SnapsToDevicePixels="True">
                        <Border x:Name="bg" CornerRadius="8" Background="Transparent"/>
                        <Border x:Name="bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,10"
                                Background="Transparent"/>
                        <Grid x:Name="row" Margin="14,0,10,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="icon" Width="20" Height="20" Stretch="None" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{DynamicResource TextSecondaryBrush}" SnapsToDevicePixels="False"
                                  Data="{Binding Path=(shell:NavRail.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="label" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              Margin="12,0,0,0" VerticalAlignment="Center"
                                              TextElement.FontSize="{StaticResource FontSizeLarge}"
                                              TextElement.FontWeight="Medium"
                                              TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                            <Setter TargetName="label" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource TextBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="label" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter TargetName="label" Property="TextElement.FontWeight" Value="SemiBold"/>
                            <Setter TargetName="icon" Property="Stroke" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <!-- The active item's indicator in the current game's colour (NavRail.UseGameAccent). -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="shell:NavRail.HasAccent" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bar" Property="Background"
                                    Value="{Binding Path=(shell:NavRail.Accent), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </MultiTrigger>
                        <Trigger Property="shell:NavRail.IsCompact" Value="True">
                            <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="row" Property="Margin" Value="0"/>
                            <Setter TargetName="row" Property="HorizontalAlignment" Value="Center"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Icon-only rail: the label moves into a tooltip. -->
            <Trigger Property="shell:NavRail.IsCompact" Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding Header, RelativeSource={RelativeSource Self}, Converter={StaticResource AccessKeyText}}"/>
                <Setter Property="ToolTipService.Placement" Value="Right"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Pages ═══ -->
    <!-- Settings pages: 24 px gutter, content capped at 960 and centred (Postacie keeps the full width). -->
    <Style x:Key="PageScroller" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="PageContent" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="960"/>
        <Setter Property="Margin" Value="24,24,24,24"/>
    </Style>
    <Style x:Key="PageHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageLead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,20"/>
    </Style>
    <!-- Section eyebrow: 11 px caps, tracked, muted; only where sections repeat. Set the text with shell:Typo.Eyebrow. -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ═══ Chips ═══ -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
    <!-- A key cap: Ctrl, Shift, S as separate chips. -->
    <Style x:Key="KbdChip" TargetType="Border">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="7,2,7,3"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="KbdText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ Loading and empty states ═══ -->
    <Style x:Key="SkeletonBar" TargetType="Border">
        <Setter Property="Height" Value="12"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource SkeletonBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <!-- Soft pulse unless Windows animations are off. -->
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="MaxWidth" Value="440"/>
    </Style>

    <!-- ═══ Buttons used by the shell ═══ -->
    <!-- Text action with an arrow: "Zmień skrót →". 44 px tall hit area without moving the line. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" MinHeight="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentPresenter x:Name="text" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <Path x:Name="arrow" Data="{StaticResource IconArrowRight}" Width="16" Height="16" Margin="6,1,0,0"
                                  Stretch="None" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A shortcut inside a Start tile (Skróty › Karta buildu): one row that is a button. An icon chip, a title and a
         hint, the external-link mark at the end; a sunken surface and a hairline so it reads as clickable next to the
         key-cap rows. At least 44 px tall; hover, pressed, disabled and the keyboard focus ring in palette keys, so
         high contrast maps them like every other control. -->
    <Style x:Key="ShortcutTile" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Padding" Value="10,8,14,8"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightLarge}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status bar icon: 44 × 44 hit area, 18 px glyph, tooltip and automation name from Tag. -->
    <Style x:Key="BarIconButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}"/>
        <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="8" Margin="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Więcej" in the status bar: a quiet labelled button that opens the overflow menu above it. -->
    <Style x:Key="BarTextButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="8" Margin="4" Padding="10,0,8,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The overflow menu ("Więcej"): a raised panel in the palette, the shadow on its own layer so text stays crisp. -->
    <Style x:Key="BarMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="12">
                        <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.24"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="216">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BarMenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" MinHeight="36" Padding="10,0,16,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Path x:Name="check" Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="None" StrokeThickness="1.8"
                                  Stroke="{DynamicResource AccentBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A group label inside the menu ("Język"); never focused, never clicked. -->
    <Style x:Key="BarMenuCaption" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <ContentPresenter ContentSource="Header" Margin="14,8,14,4" TextElement.FontSize="{StaticResource FontSizeSmall}"
                                      TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextTertiaryBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BarMenuSeparator" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource HairlineBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Version chip in the status bar: looks like a chip, behaves like a link. -->
    <Style x:Key="BarChipButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" MinHeight="26" CornerRadius="13" Padding="10,3" Background="Transparent"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Toggle switch (a CheckBox): label left, 40 × 22 track right. ═══ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <!-- The knob slides to its side when the user flips the switch (Motion; still with animations off). -->
        <Setter Property="shell:Motion.SlideKnob" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="True"/>
                        <Grid Grid.Column="1" Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="track" CornerRadius="11" Background="{DynamicResource SurfacePressedBrush}"
                                    BorderBrush="{DynamicResource BorderHoverBrush}" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentFillBrush}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource TextOnAccentBrush}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource TextBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentFillHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Segmented choice (RadioButtons in a row): theme, and any short either/or. ═══ -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="{StaticResource RadiusButton}" Padding="{TemplateBinding Padding}"
                            Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Slider with its value at the end of its track (Wygląd napisów): no number box beside it. ═══ -->
    <Style x:Key="ValueSliderTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ValueSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="shell:SliderValue.Format" Value="{}{0:0}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- The value is a fixed label at the right end of its own track, in tabular figures: it stays in its
                         row and does not move with the thumb. -->
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ValueSliderTrack}" Background="{DynamicResource AccentBrush}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ValueSliderTrack}" Background="{DynamicResource BorderBrush}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="22" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="halo" Fill="{DynamicResource FocusHaloBrush}" Opacity="0" Margin="-4"/>
                                                <Ellipse x:Name="knob" Width="18" Height="18" Fill="{DynamicResource SurfaceBrush}"
                                                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentLightBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                    <Setter TargetName="halo" Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="halo" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <TextBlock Grid.Column="1" MinWidth="56" Margin="16,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   Text="{Binding Path=(shell:SliderValue.Text), RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ A look to pick (Wygląd napisów): a card that is a radio button. ═══ -->
    <Style x:Key="PresetCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="{StaticResource RadiusCard}" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter RecognizesAccessKey="True"/>
                            <!-- The chosen look: an accent tick in the corner, not only a colour change. -->
                            <Border x:Name="tick" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,6,0" Background="{DynamicResource AccentFillBrush}" Visibility="Collapsed">
                                <Path Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="None" Margin="2,2,0,0"
                                      Stroke="{DynamicResource TextOnAccentBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ The band: Kaption's own subtitle look (site .k-band). Always ink, in both themes. ═══ -->
    <SolidColorBrush x:Key="BandBgBrush" Color="#0B0D17"/>
    <SolidColorBrush x:Key="BandTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BandSubBrush" Color="#A8AEBD"/>
    <SolidColorBrush x:Key="BandDetailBrush" Color="#C9CED8"/>
    <SolidColorBrush x:Key="BandHairlineBrush" Color="#1FFFFFFF"/>
    <!-- The game's scene reads at about 58 % from the middle to the right edge (ink at 42 %); the text side gets more ink
         so the state line, the pair and "Zmień grę" keep their contrast on every game's art (ShellRenderTests measures
         it behind each text). -->
    <LinearGradientBrush x:Key="BandScrimBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B80B0D17" Offset="0"/>
        <GradientStop Color="#8C0B0D17" Offset="0.35"/>
        <GradientStop Color="#6B0B0D17" Offset="0.6"/>
        <GradientStop Color="#6B0B0D17" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="BandCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BandBgBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BandHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="168"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="BandSpeaker" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="BandLine" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BandTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="BandSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource BandSubBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BandChip" TargetType="Border">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="BorderBrush" Value="#29FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Quiet secondary on the band ("Zmień grę"): text on ink, a white wash on hover. -->
    <Style x:Key="BandGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BandDetailBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource RadiusButton}" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#17FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource BandTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Band accents for text and marks on ink (the setup window's step rail). -->
    <SolidColorBrush x:Key="BandAccentBrush" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="BandMutedBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="BandRingBrush" Color="#4DFFFFFF"/>
    <LinearGradientBrush x:Key="RailScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8C0B0D17" Offset="0"/>
        <GradientStop Color="#E60B0D17" Offset="0.55"/>
        <GradientStop Color="#F70B0D17" Offset="1"/>
    </LinearGradientBrush>

    <!-- Quiet primary on the band (waiting for the game, retry, account): an outline. The brand gradient is for
         starting and stopping translation only. -->
    <Style x:Key="BandOutlineButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BandTextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeightLarge}"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="#0FFFFFFF"
                            BorderBrush="{StaticResource BandRingBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#80FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A link inside band text ("Zmień grę" after the waiting sentence). -->
    <Style x:Key="BandLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource BandAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BandTextBrush}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ Status mark for checklists (Views/Shell/StatusMark.cs) ═══ -->
    <Style TargetType="shell:StatusMark">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shell:StatusMark">
                    <Grid>
                        <Ellipse x:Name="ring" Stroke="{DynamicResource BorderHoverBrush}" StrokeThickness="1.5"/>
                        <Path x:Name="arc" Data="M 11,1.5 A 9.5,9.5 0 0 1 20.5,11" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="spin" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                        <Ellipse x:Name="fill" Fill="{DynamicResource SuccessBrush}" Visibility="Collapsed"/>
                        <Path x:Name="check" Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="None" Margin="3,3,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource BgBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                        <Path x:Name="warn" Data="{StaticResource IconWarning}" Width="16" Height="16" Stretch="None" Margin="3,2,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Working">
                            <Setter TargetName="arc" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource SkeletonBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="spinning">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="spinning"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="State" Value="Done">
                            <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="State" Value="Warning">
                            <Setter TargetName="ring" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="warn" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One key-cap row: "Start / stop  [Ctrl][Shift][S]" (Start page, setup window). -->
    <DataTemplate x:Key="HotkeyCapsRow">
        <Grid MinHeight="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}" Focusable="False" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Spoken}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KbdChip}">
                            <TextBlock Text="{Binding}" Style="{StaticResource KbdText}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- ═══ Dialog windows: the ambience backdrop and the card that sits on it ═══ -->
    <LinearGradientBrush x:Key="BackdropScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#990B0D17" Offset="0"/>
        <GradientStop Color="#E60B0D17" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
        <Setter Property="Padding" Value="28,28,28,24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ "Zaawansowane": collapsed by default, one hairline row, chevron turns when open. ═══ -->
    <Style x:Key="AdvancedExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Cursor="Hand" MinHeight="40" Focusable="True"
                                      FocusVisualStyle="{StaticResource FocusRingInset}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="row" Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}"
                                            BorderThickness="0,1,0,0" Padding="2,10,8,10" CornerRadius="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                            <Path x:Name="chevron" Grid.Column="1" Data="{StaticResource IconChevronDown}" Width="16" Height="16"
                                                  Stretch="None" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="chevron" Property="Stroke" Value="{DynamicResource TextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                       FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </ToggleButton>
                        <Border x:Name="ContentSite" Visibility="Collapsed" Padding="0,4,0,8">
                            <ContentPresenter/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
